<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>SmartRemont.ExportSpecifications</RootNamespace>
    <AssemblyName>SmartRemont.ExportSpecifications</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DeployToRevit Condition="'$(DeployToRevit)' == ''">false</DeployToRevit>
  </PropertyGroup>

  <!-- RevitAPI тянет Microsoft.VisualBasic 10.1; без Desktop.App MSBuild ругается MSB3277 (net8 ref = 10.0). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <!-- Revit API 2025 (установленный Revit или NuGet) и годы деплоя — см. build/RevitApi.props. -->
  <Import Project="..\build\RevitApi.props" />

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BrandAssets.cs" />
    <Compile Include="ExportSpecificationsApplication.cs" />
    <Compile Include="Commands\ExportSpecificationsCommand.cs" />
    <Compile Include="DTO\ScheduleExportDto.cs" />
    <Compile Include="Services\ScheduleExportService.cs" />
    <Compile Include="Views\ScheduleRowVm.cs" />
    <Compile Include="Views\ExportSpecificationsWindow.xaml.cs">
      <DependentUpon>ExportSpecificationsWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="Views\ExportSpecificationsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\export_32.png" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

  <!-- Раскладывает add-in в Addins\<год>\ для каждого года из RevitDeployYears (по умолчанию 2025 и 2027). -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true'">
    <ItemGroup>
      <_DeployFiles Include="$(TargetDir)*.dll" />
      <_DeployResourceFiles Include="Resources\*.png" />
      <_AddinManifest Include="$(MSBuildProjectDirectory)\..\deploy\SmartRemont.ExportSpecifications.addin" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinsRoot)%(RevitDeployYear.Identity)\SmartRemont.ExportSpecifications\Resources\" />
    <Copy SourceFiles="@(_AddinManifest)"
          DestinationFolder="$(RevitAddinsRoot)%(RevitDeployYear.Identity)\"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Copy SourceFiles="@(_DeployResourceFiles)"
          DestinationFolder="$(RevitAddinsRoot)%(RevitDeployYear.Identity)\SmartRemont.ExportSpecifications\Resources\"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Copy SourceFiles="@(_DeployFiles)"
          DestinationFolder="$(RevitAddinsRoot)%(RevitDeployYear.Identity)\SmartRemont.ExportSpecifications\"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>
</Project>
