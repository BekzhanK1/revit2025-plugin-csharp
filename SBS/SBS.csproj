<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>SBS</RootNamespace>
    <AssemblyName>SBS</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Users\Bekzhan-SmartRemont\Desktop\revitapi\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Users\Bekzhan-SmartRemont\Desktop\revitapi\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Configs.cs" />
    <Compile Include="AppTools.cs" />
    <Compile Include="Commands\BaseCommand.cs" />
    <Compile Include="Commands\SbsWallsCommand.cs" />
    <Compile Include="Commands\ExportAllElementsCommand.cs" />
    <Compile Include="Commands\ExportSmartRemontCommand.cs" />
    <Compile Include="Commands\ExportSmartRemontSchedulesCommand.cs" />
    <Compile Include="Commands\ExportSmartRemontDiagnosticsCommand.cs" />
    <Compile Include="DTO\WallInfoDto.cs" />
    <Compile Include="DTO\WallLinesDto.cs" />
    <Compile Include="DTO\WallStructureDto.cs" />
    <Compile Include="DTO\SmartRemontWallExportDto.cs" />
    <Compile Include="DTO\SmartRemontScheduleExportDto.cs" />
    <Compile Include="DTO\SmartRemontModelDiagnosticsDto.cs" />
    <Compile Include="DTO\RevitElementDto.cs" />
    <Compile Include="DTO\ParameterDto.cs" />
    <Compile Include="DTO\GeometryLineDto.cs" />
    <Compile Include="DTO\BoundingBoxDto.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Include="Views\ViewContainer.xaml.cs">
      <DependentUpon>ViewContainer.xaml</DependentUpon>
    </Compile>
    <Compile Include="Views\ExportSettingsDialog.xaml.cs">
      <DependentUpon>ExportSettingsDialog.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\unit.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="Views\ViewContainer.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\ExportSettingsDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>