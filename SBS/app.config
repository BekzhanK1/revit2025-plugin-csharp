<?xml version="1.0" encoding="utf-8"?>

<configuration>

  <appSettings>

    <!-- true = тест (office-testapi), false = prod (myspace-api). После смены — перезапуск Revit. -->

    <add key="useTestApi" value="true" />

    <!-- Необязательно: свой URL вместо пресетов test/prod. Пусто — не используется.
         При сборке: dotnet build -p:ApiOriginUrl=http://localhost:8000. В Revit: 5 кликов по чипу версии в окне входа. -->

    <add key="apiOriginUrl" value="" />

    <add key="s3OriginUrl" value="https://s3.smartremont.kz/smartremont" />

  </appSettings>

</configuration>

