<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- true = тест (office-testapi), false = prod (myspace-api). После смены — перезапуск Revit. -->
    <add key="useTestApi" value="false" />
    <!-- Необязательно: свой URL вместо пресетов test/prod -->
    <!-- <add key="apiOriginUrl" value="https://example.smart-remont.kz" /> -->
    <add key="s3OriginUrl" value="https://s3.smartremont.kz/smartremont" />
  </appSettings>
</configuration>
