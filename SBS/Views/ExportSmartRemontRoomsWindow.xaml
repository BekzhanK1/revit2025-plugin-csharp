<Window x:Class="SmartRemont.ExportRooms.Views.ExportSmartRemontRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SmartRemont — Экспорт помещений"
        Width="780"
        MinWidth="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,6"/>
            </Style>

            <Style x:Key="StatBadge" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="MinWidth" Value="130"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ─── Header ─── -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Экспорт помещений" Style="{StaticResource Heading1}"/>
                        <TextBlock Text="Настройте параметры экспорта перед выгрузкой JSON" Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Grid>

                <!-- ─── Phase selection ─── -->
                <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="ФАЗА ПРОЕКТА" Style="{StaticResource SectionLabel}"/>
                        
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Стадия проекта" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="CmbPhase"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="CmbPhase_SelectionChanged"
                                      ToolTip="Выберите фазу из которой будут взяты помещения"/>
                        </Grid>

                        <Border x:Name="PhaseInfoBorder" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtPhaseInfo" FontSize="13" Foreground="#1D4ED8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ─── Parameter mapping ─── -->
                <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="ПАРАМЕТРЫ ПОМЕЩЕНИЙ" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Укажите точные названия параметров из вашего Revit-проекта" Style="{StaticResource BodyText}" Margin="0,0,0,16"/>

                        <ItemsControl x:Name="ParameterRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Key}" Style="{StaticResource ModernInputField}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ─── Filters ─── -->
                <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="ФИЛЬТРЫ И НАСТРОЙКИ" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Квартира (фильтр)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtApartmentFilter" Style="{StaticResource ModernInputField}"
                                     TextChanged="TxtApartmentFilter_TextChanged"
                                     ToolTip="Оставьте пустым для экспорта всех квартир. Можно ввести несколько номеров через запятую: 1, 2, 5"/>
                        </Grid>

                        <CheckBox x:Name="ChkOnlyPlaced" Content="Только размещённые помещения (площадь > 0)" IsChecked="True"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkIncludeContours" Content="Включить контуры помещений (координаты)" IsChecked="True"/>
                        <CheckBox x:Name="ChkIncludeFinishes" Content="Включить объёмы отделки (полы, потолки, плинтусы/молдинги)" IsChecked="False"
                                  ToolTip="Выполняет пространственный поиск элементов отделки в каждом помещении. Может замедлить экспорт для больших моделей."/>
                    </StackPanel>
                </Border>

                <!-- ─── Schedules & mapping ─── -->
                <Border Grid.Row="4" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="24,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="СПЕЦИФИКАЦИИ И МАППИНГ" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Отметьте спецификации и укажите, какие колонки содержат данные. Настройки сохраняются автоматически."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Выбрать все" Style="{StaticResource ModernSecondaryButton}" Padding="16,0" Click="BtnSchedulesSelectAll_Click"/>
                            <Button Grid.Column="3" Content="Снять все" Style="{StaticResource ModernSecondaryButton}" Padding="16,0" Click="BtnSchedulesSelectNone_Click"/>
                        </Grid>

                        <DataGrid x:Name="SchedulesGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  ItemsSource="{Binding ScheduleRows}"
                                  MaxHeight="400"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  RowHeight="44"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsEnabled, Mode=TwoWay}" Width="40"/>
                                <DataGridTextColumn Header="Спецификация" Binding="{Binding ScheduleName}" Width="250" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Раздел (SR)" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Disciplines, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding Discipline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="32" Padding="8,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="WorkType" Binding="{Binding WorkType, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="Колонка: Material" Binding="{Binding ColMaterialName, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                <DataGridTextColumn Header="Колонка: Code" Binding="{Binding ColMaterialCode, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="Колонка: Qty" Binding="{Binding ColQuantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn Header="Колонка: Unit" Binding="{Binding ColUnit, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="Колонка: Room" Binding="{Binding ColRoomName, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="Колонка: Apt" Binding="{Binding ColApartment, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ─── Output settings ─── -->
                <Border Grid.Row="5" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="СОХРАНЕНИЕ" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Путь сохранения" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtOutputPath" IsReadOnly="True" Style="{StaticResource ModernInputField}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Grid.Column="3" Content="Обзор…" Style="{StaticResource ModernSecondaryButton}" Padding="20,0" Click="BtnBrowse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── Stats preview ─── -->
                <Border Grid.Row="6" Style="{StaticResource ModernCard}" Margin="0,0,0,24" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="ПРЕДПРОСМОТР" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource StatBadge}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtRoomCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="помещений" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBadge}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtApartmentCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="квартир" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBadge}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLevelCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="уровней" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBadge}" Margin="0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtTotalArea" Text="—" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="м² площадь" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mini room list -->
                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="200" Background="#F8FAFC">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PreviewList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ApartmentNumber}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding LevelName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding AreaStr}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="TxtPreviewNote" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ─── Action buttons ─── -->
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="TxtStatus" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="Отмена" Style="{StaticResource ModernSecondaryButton}" Padding="24,0" Click="BtnCancel_Click"/>
                    <Button Grid.Column="3" x:Name="BtnExport" Content="Экспортировать JSON"
                            Style="{StaticResource ModernPrimaryButton}"
                            Padding="32,0"
                            IsEnabled="False"
                            Click="BtnExport_Click"/>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
