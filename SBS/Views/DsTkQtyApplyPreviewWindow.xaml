<Window x:Class="SmartRemont.ExportRooms.Views.DsTkQtyApplyPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка объёмов перед отправкой"
        Width="960"
        Height="600"
        MinWidth="740"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource HeaderIconTile}" Width="40" Height="40" CornerRadius="10">
                    <TextBlock Text="&#xE898;" Style="{StaticResource HeaderIconGlyph}" FontSize="18"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Что уйдёт в ДС" Style="{StaticResource PageTitle}" FontSize="18"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATS -->
        <Grid Grid.Row="1" Margin="28,18,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatBadge}">
                <StackPanel>
                    <TextBlock x:Name="StatSendValue" Style="{StaticResource StatValue}" Foreground="{StaticResource InfoTextBrush}" Text="—"/>
                    <TextBlock Text="уйдёт в ДС" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatBadge}">
                <StackPanel>
                    <TextBlock x:Name="StatSkipValue" Style="{StaticResource StatValue}" Foreground="#C2410C" Text="—"/>
                    <TextBlock x:Name="StatSkipLabel" Text="не редактируются" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatBadge}" Margin="0">
                <StackPanel>
                    <TextBlock x:Name="StatDsValue" Style="{StaticResource StatValue}" Foreground="{StaticResource TextPrimaryBrush}" Text="—"/>
                    <TextBlock Text="черновик ДС" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TABLE -->
        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="2"
                  Margin="28,0,28,20"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Комната" Binding="{Binding RoomDisplay}" Width="1.1*" MinWidth="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialDisplay}" Width="2*" MinWidth="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Конструктив" Binding="{Binding WorkSetDisplay}" Width="1.3*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ДС/ТК" Binding="{Binding TkQtyDisplay}" Width="70" MinWidth="64">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Проект" Binding="{Binding ScheduleQtyDisplay}" Width="70" MinWidth="64">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Δ" Binding="{Binding DeltaDisplay}" Width="64" MinWidth="56">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
                            <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ед. Revit" Binding="{Binding QtyUnitDisplay}" Width="72" MinWidth="48">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="EditableColumn"
                                    Header="Ед. MySpace"
                                    Binding="{Binding MyspaceUnitDisplay}"
                                    Width="88"
                                    MinWidth="64"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- FOOTER -->
        <Border Grid.Row="3" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHintText"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Отмена"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Content="Отправить"
                            Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="160"
                            Padding="16,0"
                            IsDefault="True"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
