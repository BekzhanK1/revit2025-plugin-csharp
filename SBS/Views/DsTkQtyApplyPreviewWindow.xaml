<Window x:Class="SmartRemont.ExportRooms.Views.DsTkQtyApplyPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка объёмов перед отправкой"
        Width="920"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Что уйдёт в ДС" Style="{StaticResource Heading1}" FontSize="20"/>
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatBadge}" Background="#EFF6FF" BorderBrush="#BFDBFE" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="StatSendValue" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Text="—"/>
                        <TextBlock Text="уйдёт в ДС" FontSize="12" Foreground="#1E40AF"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatBadge}" Background="#FFF7ED" BorderBrush="#FED7AA" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="StatSkipValue" FontSize="18" FontWeight="Bold" Foreground="#C2410C" Text="—"/>
                        <TextBlock x:Name="StatSkipLabel" Text="не редактируются" FontSize="12" Foreground="#9A3412"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatBadge}" Background="#F8FAFC" BorderBrush="#E2E8F0" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="StatDsValue" FontSize="18" FontWeight="Bold" Foreground="#334155" Text="—"/>
                        <TextBlock Text="черновик ДС" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <DataGrid x:Name="PreviewGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#E2E8F0"
                      BorderThickness="1"
                      RowHeight="36"
                      AlternatingRowBackground="#F8FAFC"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Комната" Binding="{Binding RoomDisplay}" Width="1.1*" MinWidth="90"/>
                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialDisplay}" Width="2*" MinWidth="140"/>
                    <DataGridTextColumn Header="Комплект" Binding="{Binding WorkSetDisplay}" Width="1.3*" MinWidth="100"/>
                    <DataGridTextColumn Header="Договор" Binding="{Binding TkQtyDisplay}" Width="70" MinWidth="64"/>
                    <DataGridTextColumn Header="Проект" Binding="{Binding ScheduleQtyDisplay}" Width="70" MinWidth="64"/>
                    <DataGridTextColumn Header="Δ" Binding="{Binding DeltaDisplay}" Width="64" MinWidth="56"/>
                    <DataGridTextColumn Header="Ед." Binding="{Binding QtyUnitDisplay}" Width="56" MinWidth="48"/>
                    <DataGridTextColumn x:Name="EditableColumn"
                                      Header="MySpace"
                                      Binding="{Binding MyspaceEditableDisplay}"
                                      Width="72"
                                      MinWidth="64"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="FooterHintText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButton}"
                            Width="110"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Content="Отправить"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="160"
                            Padding="16,0"
                            IsDefault="True"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
