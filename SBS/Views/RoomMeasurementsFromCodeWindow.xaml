<Window x:Class="SmartRemont.ExportRooms.Views.RoomMeasurementsFromCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Замеры по коду"
        MinWidth="820"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE943;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Замеры по коду" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Из модели: периметры, двери, плитка, фартук (сначала ведомость, иначе ERBO_Площадь на стенах кухни), площадь стен."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="EventStatusBanner"
                    Grid.Row="0"
                    Style="{StaticResource CalloutInfo}"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource CalloutIcon}" Foreground="{StaticResource InfoBrush}"/>
                    <TextBlock x:Name="EventStatusBannerText"
                               Grid.Column="1"
                               FontSize="13"
                               Foreground="{StaticResource InfoTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ПО КОМНАТАМ" Style="{StaticResource SectionLabel}"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RoomsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ContentCard}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoomName}"
                                                   Style="{StaticResource CardTitle}"
                                                   Margin="0,0,0,10"/>
                                        <DataGrid ItemsSource="{Binding Parameters}"
                                                  Style="{StaticResource ModernDataGrid}"
                                                  views:ScrollBehavior.BubbleMouseWheel="True"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  RowHeight="36"
                                                  MinHeight="80">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="param_name"
                                                                    Binding="{Binding param_name}"
                                                                    Width="2*"/>
                                                <DataGridTextColumn Header="param_code"
                                                                    Binding="{Binding param_code}"
                                                                    Width="160">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                                            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="param_value"
                                                                    Binding="{Binding param_value_display}"
                                                                    Width="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           x:Name="NoDataTextBlock"
                           Text="Не удалось прочитать помещения из модели."
                           Style="{StaticResource EmptyStateText}"
                           Margin="0,16,0,0"
                           Visibility="Collapsed"/>
            </Grid>

            <Border x:Name="MappingPanel"
                    Grid.Row="2"
                    Style="{StaticResource ContentCard}"
                    Padding="18,14"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Расчёт по модели" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SourcesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12"
                                               Margin="0,0,0,6"
                                               Text="{Binding LineText}"
                                               Foreground="{Binding StatusBrush}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MappingToggleButton"
                            Content="Детали расчёта"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Click="MappingToggleButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                    <Button x:Name="SendButton"
                            Content="Отправить"
                            Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="140"
                            IsDefault="True"
                            IsEnabled="False"
                            Click="SendButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
