<Window x:Class="SmartRemont.ExportRooms.Views.RoomMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Материалы по комнатам"
        Width="900"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="32,28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBlock" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="RoomBlock" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialsDataGrid" TargetType="DataGrid">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinRowHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="RowBackground" Value="White"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Материалы по комнатам"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Название, ID и количество. Зелёный — в каталоге, красный — нет в базе."
                           FontSize="13"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,12,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#1B6FC8"
                               VerticalAlignment="Top"
                               Margin="0,1,10,0"/>
                    <TextBlock x:Name="FormulaHintTextBlock"
                               FontSize="13"
                               Foreground="#1E40AF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="CatalogBanner"
                    Grid.Row="2"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="CatalogLoadingPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <ProgressBar Width="140"
                                     Height="6"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"/>
                        <TextBlock x:Name="CatalogLoadingTextBlock"
                                   FontSize="13"
                                   Foreground="#1E40AF"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CatalogBannerTextBlock"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource SectionBlock}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ПО КОМНАТАМ" Style="{StaticResource SectionLabel}"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RoomBlock}" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="#1B6FC8"
                                                        CornerRadius="2"
                                                        Margin="0,2,12,2"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RoomName}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="2"
                                                        Background="#F3F4F6"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SummaryBadge}"
                                                               FontSize="11"
                                                               Foreground="#6B7280"/>
                                                </Border>
                                            </Grid>

                                            <DataGrid ItemsSource="{Binding TableRows}"
                                                      Style="{StaticResource MaterialsDataGrid}"
                                                      MinHeight="56">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CatalogStatusKey}" Value="found">
                                                                <Setter Property="Background" Value="#ECFDF5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CatalogStatusKey}" Value="missing">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Название"
                                                                        Binding="{Binding Name}"
                                                                        Width="5*"
                                                                        MinWidth="220">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTemplateColumn Header="ID" Width="2*" MinWidth="100">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="4" Padding="6,4" HorizontalAlignment="Stretch">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CatalogStatusKey}" Value="found">
                                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding CatalogStatusKey}" Value="missing">
                                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding ProductId}"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CatalogStatusKey}" Value="found">
                                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding CatalogStatusKey}" Value="missing">
                                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Кол-во" Width="90" MinWidth="80">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#E0E7FF"
                                                                        CornerRadius="10"
                                                                        Padding="8,2"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding QuantityDisplay}" Value="—">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding QuantityDisplay}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#3730A3"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               x:Name="NoDataTextBlock"
                               Text="Не удалось найти материалы в помещениях."
                               FontSize="13"
                               Foreground="#999999"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="DetailsPanel"
                    Grid.Row="4"
                    Style="{StaticResource SectionBlock}"
                    Padding="14,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ИСТОЧНИКИ И ФОРМУЛЫ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DetailsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12"
                                               Margin="0,0,0,8"
                                               Text="{Binding LineText}"
                                               Foreground="{Binding StatusBrush}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" Margin="0,20,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,0,420,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetryValidationButton"
                            Content="Проверить каталог"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"
                            Click="RetryValidationButton_Click"/>
                    <Button x:Name="DetailsToggleButton"
                            Content="Детали расчёта"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"
                            Click="DetailsToggleButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource SecondaryButton}"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
