<Window x:Class="SmartRemont.ExportRooms.Views.RoomMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Материалы по комнатам"
        Width="960"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="WrapCellText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Материалы по комнатам" Style="{StaticResource Heading1}"/>
                <TextBlock Text="Сначала проверка каталога системы, затем сверка с текстовым конструктором (ТК)." Style="{StaticResource BodyText}"/>
            </StackPanel>

            <!-- STATS GRID -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatRoomsValue" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="—"/>
                        <TextBlock Text="комнат" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatTotalValue" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="—"/>
                        <TextBlock Text="позиций" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatBadge}" Background="#F0FDF4" BorderBrush="#BBF7D0">
                    <StackPanel>
                        <TextBlock x:Name="StatInTkValue" FontSize="20" FontWeight="Bold" Foreground="#15803D" Text="—"/>
                        <TextBlock Text="совпадает с ТК" FontSize="12" Foreground="#166534"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatBadge}" Background="#FEF2F2" BorderBrush="#FECACA">
                    <StackPanel>
                        <TextBlock x:Name="StatMissingSystemValue" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Text="—"/>
                        <TextBlock Text="нет в системе" FontSize="12" Foreground="#991B1B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatBadge}" Background="#FFF7ED" BorderBrush="#FED7AA">
                    <StackPanel>
                        <TextBlock x:Name="StatNotInTkValue" FontSize="20" FontWeight="Bold" Foreground="#C2410C" Text="—"/>
                        <TextBlock Text="нет в ТК" FontSize="12" Foreground="#9A3412"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource StatBadge}" Background="#FFFBEB" BorderBrush="#FDE68A" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="StatTkOnlyValue" FontSize="20" FontWeight="Bold" Foreground="#B45309" Text="—"/>
                        <TextBlock Text="только в ТК" FontSize="12" Foreground="#92400E"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CATALOG BANNER -->
            <Border x:Name="CatalogBanner"
                    Grid.Row="2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="CatalogLoadingPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="CatalogLoadingTextBlock" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CatalogBannerTextBlock" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- MAIN LIST -->
            <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="СПИСОК ПОМЕЩЕНИЙ" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="TkDifferencesOnlyCheckBox"
                                  Content="Скрыть совпадения (только проблемы)"
                                  HorizontalAlignment="Right"
                                  Checked="TkDifferencesOnlyCheckBox_Changed"
                                  Unchecked="TkDifferencesOnlyCheckBox_Changed"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <TextBlock Text="{Binding RoomName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SummaryBadge}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- DataGrid per room -->
                                            <DataGrid ItemsSource="{Binding TableRows}"
                                                      Style="{StaticResource ModernDataGrid}"
                                                      MinHeight="48"
                                                      IsReadOnly="True"
                                                      SelectionMode="Single"
                                                      SelectionUnit="FullRow">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="missing_system">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="not_in_tk">
                                                                <Setter Property="Background" Value="#FFF7ED"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="tk_only">
                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="in_tk">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Материал" Binding="{Binding Name}" Width="4*" MinWidth="200">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="90" MinWidth="72">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="160" MinWidth="140">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="missing_system">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="not_in_tk">
                                                                        <Setter Property="Foreground" Value="#C2410C"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="tk_only">
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="in_tk">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="in_system">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding QuantityDisplay}" Width="72" MinWidth="64">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               x:Name="NoDataTextBlock"
                               Text="Материалы в помещениях не найдены."
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- DETAILS PANEL -->
            <Border x:Name="DetailsPanel"
                    Grid.Row="4"
                    Background="#FAFAFA"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ДЕТАЛИ ПРОЦЕССА" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DetailsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="13" Margin="0,0,0,8" Text="{Binding LineText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- FOOTER BUTTONS -->
            <Grid Grid.Row="5" Margin="0,24,0,0">
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,320,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetryValidationButton" Content="Обновить" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,12,0" Padding="20,0" Click="RetryValidationButton_Click"/>
                    <Button x:Name="DetailsToggleButton" Content="Лог проверки" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,12,0" Padding="20,0" Click="DetailsToggleButton_Click"/>
                    <Button x:Name="CloseButton" Content="Закрыть" Style="{StaticResource ModernPrimaryButton}" IsCancel="True" Padding="32,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
