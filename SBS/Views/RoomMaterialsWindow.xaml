<Window x:Class="SmartRemont.ExportRooms.Views.RoomMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Материалы по комнатам"
        Width="900"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="28,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="RoomBlock" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialsDataGrid" TargetType="DataGrid">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinRowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="White"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Материалы по комнатам"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Сначала проверка каталога системы, затем сверка с текстовым конструктором (ТК)."
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="StatRoomsValue" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock Text="комнат" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="StatTotalValue" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock Text="позиций" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="StatInTkValue" Style="{StaticResource StatValue}" Text="—" Foreground="#15803D"/>
                        <TextBlock Text="совпадает с ТК" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="StatMissingSystemValue" Style="{StaticResource StatValue}" Text="—" Foreground="#DC2626"/>
                        <TextBlock Text="нет в системе" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="StatNotInTkValue" Style="{StaticResource StatValue}" Text="—" Foreground="#C2410C"/>
                        <TextBlock Text="нет в ТК" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource StatCard}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="StatTkOnlyValue" Style="{StaticResource StatValue}" Text="—" Foreground="#B45309"/>
                        <TextBlock Text="только в ТК" Style="{StaticResource StatLabel}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="CatalogBanner"
                    Grid.Row="2"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="CatalogLoadingPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <ProgressBar Width="120"
                                     Height="5"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
                        <TextBlock x:Name="CatalogLoadingTextBlock"
                                   FontSize="12"
                                   Foreground="#374151"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CatalogBannerTextBlock"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Background="#FAFAFA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="По комнатам"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"/>
                        <CheckBox x:Name="TkDifferencesOnlyCheckBox"
                                  Content="Скрыть совпадения (только проблемы)"
                                  HorizontalAlignment="Right"
                                  FontSize="12"
                                  Checked="TkDifferencesOnlyCheckBox_Changed"
                                  Unchecked="TkDifferencesOnlyCheckBox_Changed"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RoomBlock}" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="{Binding RoomName}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SummaryBadge}"
                                                           FontSize="11"
                                                           Foreground="#9CA3AF"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <DataGrid ItemsSource="{Binding TableRows}"
                                                      Style="{StaticResource MaterialsDataGrid}"
                                                      MinHeight="48">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="missing_system">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="not_in_tk">
                                                                <Setter Property="Background" Value="#FFF7ED"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="tk_only">
                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKey}" Value="in_tk">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Материал"
                                                                        Binding="{Binding Name}"
                                                                        Width="4*"
                                                                        MinWidth="200">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="ID"
                                                                        Binding="{Binding ProductId}"
                                                                        Width="90"
                                                                        MinWidth="72">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                                <Setter Property="Foreground" Value="#374151"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Статус"
                                                                        Binding="{Binding StatusDisplay}"
                                                                        Width="160"
                                                                        MinWidth="140">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="missing_system">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="not_in_tk">
                                                                        <Setter Property="Foreground" Value="#C2410C"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="tk_only">
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="in_tk">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="in_system">
                                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Кол-во"
                                                                        Binding="{Binding QuantityDisplay}"
                                                                        Width="72"
                                                                        MinWidth="64">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               x:Name="NoDataTextBlock"
                               Text="Материалы в помещениях не найдены."
                               FontSize="13"
                               Foreground="#9CA3AF"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="DetailsPanel"
                    Grid.Row="4"
                    Background="#FAFAFA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Детали" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DetailsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12"
                                               Margin="0,0,0,8"
                                               Text="{Binding LineText}"
                                               Foreground="{Binding StatusBrush}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" Margin="0,16,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,0,280,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetryValidationButton"
                            Content="Обновить"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="RetryValidationButton_Click"/>
                    <Button x:Name="DetailsToggleButton"
                            Content="Детали"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="DetailsToggleButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource SecondaryButton}"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
