<Window x:Class="SmartRemont.ExportRooms.Views.ExportSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки экспорта" Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите параметры для экспорта:" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Основные параметры" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="chkGeometry" Content="Геометрия элементов" IsChecked="True" Margin="5"/>
                        <CheckBox x:Name="chkBoundingBox" Content="Габариты (BoundingBox)" IsChecked="True" Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Группы параметров" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="chkAll" Content="Все параметры" IsChecked="True" Margin="5" Checked="ChkAll_Checked" Unchecked="ChkAll_Unchecked"/>
                        <Separator Margin="5"/>
                        <CheckBox x:Name="chkGeometryParams" Content="Геометрия (размеры, объем, площадь)" IsChecked="True" Margin="5,5,5,2"/>
                        <CheckBox x:Name="chkMaterials" Content="Материалы и структура" IsChecked="True" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkConstruction" Content="Конструкция (зависимости, смещения)" IsChecked="True" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkIdentity" Content="Идентификация (марка, комментарий)" IsChecked="True" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkPhasing" Content="Стадии" IsChecked="True" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkStructural" Content="Конструктивные данные" IsChecked="True" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkAnalytical" Content="Аналитические свойства" IsChecked="False" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkElectrical" Content="Электрика" IsChecked="False" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkMechanical" Content="Механика (ОВиК)" IsChecked="False" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkPlumbing" Content="Сантехника" IsChecked="False" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkGraphics" Content="Графика" IsChecked="False" Margin="5,2,5,2"/>
                        <CheckBox x:Name="chkOther" Content="Прочие параметры" IsChecked="True" Margin="5,2,5,5"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Пользовательские параметры" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="chkSharedParams" Content="Общие параметры" IsChecked="True" Margin="5"/>
                        <CheckBox x:Name="chkProjectParams" Content="Параметры проекта" IsChecked="True" Margin="5"/>
                        <CheckBox x:Name="chkTypeParams" Content="Параметры типа" IsChecked="True" Margin="5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="Выбрать все" Width="100" Height="30" Margin="5" Click="SelectAll_Click"/>
            <Button Content="Снять все" Width="100" Height="30" Margin="5" Click="DeselectAll_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Height="30" Margin="5" Click="OK_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="80" Height="30" Margin="5" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

