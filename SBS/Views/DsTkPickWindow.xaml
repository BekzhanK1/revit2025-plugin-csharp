<Window x:Class="SmartRemont.ExportRooms.Views.DsTkPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбрать ДС на изменение ТК"
        Width="520"
        Height="420"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Выбор ДС" Style="{StaticResource Heading1}" FontSize="20"/>
                <TextBlock Text="Привязать сверку к черновику TK_CHANGE. Утверждённые и на согласовании недоступны для правок."
                           Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <ListBox x:Name="ItemsList"
                     Grid.Row="1"
                     BorderBrush="{StaticResource CardBorderBrush}"
                     BorderThickness="1"
                     Padding="4"
                     DisplayMemberPath="ListLabel"
                     MouseDoubleClick="ItemsList_MouseDoubleClick"/>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        Width="110"
                        HorizontalAlignment="Left"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button x:Name="SelectButton"
                        Content="Выбрать"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="SelectButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
