<Window x:Class="SmartRemont.ExportRooms.Views.RoomMeasurementsCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Сравнение замеров"
        Width="1100"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="32,28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBlock" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="RoomBlock" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompareRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Match">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ScheduleOnly">
                    <Setter Property="Background" Value="#FFF8E1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CodeOnly">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Сравнение замеров"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1B"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       Text="Спецификация Revit и расчёт по модели — в одной таблице. Цвет строки показывает результат сравнения."
                       FontSize="13"
                       Foreground="#888888"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Border Grid.Row="2"
                    Background="#FAFAFA"
                    BorderBrush="#EEEEEE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#E8F5E9"/>
                        <TextBlock Text="Совпадает" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#FFEBEE"/>
                        <TextBlock Text="Расхождение" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#FFF8E1"/>
                        <TextBlock Text="Только спецификация" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#E3F2FD"/>
                        <TextBlock Text="Только код" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="DifferencesOnlyCheckBox"
                          Content="Только расхождения"
                          FontSize="13"
                          VerticalAlignment="Center"
                          Checked="FilterCheckBox_Changed"
                          Unchecked="FilterCheckBox_Changed"/>
            </StackPanel>

            <Border Grid.Row="4" Style="{StaticResource SectionBlock}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ПО КОМНАТАМ" Style="{StaticResource SectionLabel}"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RoomBlock}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RoomName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"
                                                       Margin="0,0,0,10"/>
                                            <DataGrid ItemsSource="{Binding Parameters}"
                                                      RowStyle="{StaticResource CompareRowStyle}"
                                                      MinHeight="80">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="param_name"
                                                                        Binding="{Binding param_name}"
                                                                        Width="2*"/>
                                                    <DataGridTextColumn Header="param_code"
                                                                        Binding="{Binding param_code}"
                                                                        Width="130"/>
                                                    <DataGridTextColumn Header="Спецификация"
                                                                        Binding="{Binding schedule_value_display}"
                                                                        Width="110"/>
                                                    <DataGridTextColumn Header="Код"
                                                                        Binding="{Binding code_value_display}"
                                                                        Width="110"/>
                                                    <DataGridTextColumn Header="Δ (код − спец.)"
                                                                        Binding="{Binding delta_display}"
                                                                        Width="110"/>
                                                    <DataGridTextColumn Header="Статус"
                                                                        Binding="{Binding status_display}"
                                                                        Width="140"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               x:Name="NoDataTextBlock"
                               Text="Нет данных для сравнения."
                               FontSize="13"
                               Foreground="#999999"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="0,20,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,0,120,0"/>
                <Button x:Name="CloseButton"
                        Content="Закрыть"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
