<Window x:Class="SmartRemont.ExportRooms.Views.RoomMeasurementsCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Расхождения в замерах"
        MinWidth="960"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LegendSwatch" TargetType="Border">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="LegendText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="CompareRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="ScheduleOnly">
                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="CodeOnly">
                        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE8AB;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Сравнение замеров" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Спецификация Revit и расчёт по модели — в одной таблице. Цвет строки показывает результат сравнения."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="18,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderStrongBrush}"/>
                            <TextBlock Text="Совпадает" Style="{StaticResource LegendText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource ErrorBackgroundBrush}" BorderBrush="{StaticResource ErrorBrush}"/>
                            <TextBlock Text="Расхождение" Style="{StaticResource LegendText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"/>
                            <TextBlock Text="Только спецификация" Style="{StaticResource LegendText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBrush}"/>
                            <TextBlock Text="Только код" Style="{StaticResource LegendText}"/>
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox x:Name="DifferencesOnlyCheckBox"
                              Grid.Column="1"
                              Content="Только расхождения"
                              VerticalAlignment="Center"
                              Checked="FilterCheckBox_Changed"
                              Unchecked="FilterCheckBox_Changed"/>
                    <TextBlock x:Name="CompareStatsText"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RoomsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ContentCard}" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoomName}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding Parameters}"
                                              Style="{StaticResource ModernDataGrid}"
                                              RowStyle="{StaticResource CompareRowStyle}"
                                              local:ScrollBehavior.BubbleMouseWheel="True"
                                              MinHeight="80"
                                              IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="param_name" Binding="{Binding param_name}" Width="2*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="param_code" Binding="{Binding param_code}" Width="140">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Спецификация" Binding="{Binding schedule_value_display}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Код" Binding="{Binding code_value_display}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTemplateColumn Header="Δ (код − спец.)" Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding delta_display}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Статус" Width="160">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="StatusBadge" CornerRadius="999" BorderThickness="1" Padding="9,2" HorizontalAlignment="Left">
                                                                    <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Match">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Совпадает"/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource ErrorBackgroundBrush}"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Расхождение"/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ScheduleOnly">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Только спец."/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="CodeOnly">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource InfoBorderBrush}"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Только код"/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource InfoTextBrush}"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       x:Name="NoDataTextBlock"
                       Text="Нет данных для сравнения."
                       Style="{StaticResource EmptyStateText}"
                       Margin="0,16,0,0"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,20,0"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="Закрыть" Style="{StaticResource ModernSecondaryButton}" MinWidth="110" IsCancel="True" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <local:LoadingOverlay x:Name="LoaderOverlay" Grid.RowSpan="3" Panel.ZIndex="1000"/>
    </Grid>
</Window>
