<Window x:Class="SmartRemont.ExportRooms.Views.RoomMeasurementsCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Расхождения в замерах"
        Width="1140"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LegendSwatch" TargetType="Border">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="CompareRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                    <!-- Fade-in animation for rows -->
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Match">
                        <Setter Property="Background" Value="#F0FDF4"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                        <Setter Property="Background" Value="#FEF2F2"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="ScheduleOnly">
                        <Setter Property="Background" Value="#FFFBEB"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="CodeOnly">
                        <Setter Property="Background" Value="#EFF6FF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Сравнение замеров" Style="{StaticResource Heading1}"/>
                <TextBlock Text="Спецификация Revit и расчёт по модели — в одной таблице. Цвет строки показывает результат сравнения." Style="{StaticResource BodyText}"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#F0FDF4" BorderBrush="#BBF7D0"/>
                        <TextBlock Text="Совпадает" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#FEF2F2" BorderBrush="#FECACA"/>
                        <TextBlock Text="Расхождение" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#FFFBEB" BorderBrush="#FDE68A"/>
                        <TextBlock Text="Только спецификация" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="#EFF6FF" BorderBrush="#BFDBFE"/>
                        <TextBlock Text="Только код" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- STATS BAR -->
            <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CompareStatsText" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="DifferencesOnlyCheckBox" Content="Только расхождения" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            </StackPanel>

            <Border Grid.Row="4" Background="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ПО КОМНАТАМ" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RoomName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <DataGrid ItemsSource="{Binding Parameters}"
                                                      Style="{StaticResource ModernDataGrid}"
                                                      RowStyle="{StaticResource CompareRowStyle}"
                                                      MinHeight="80"
                                                      IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="param_name" Binding="{Binding param_name}" Width="2*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="param_code" Binding="{Binding param_code}" Width="140">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Спецификация" Binding="{Binding schedule_value_display}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Код" Binding="{Binding code_value_display}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTemplateColumn Header="Δ (код − спец.)" Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding delta_display}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Статус" Width="160">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="StatusBadge" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                                    <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Match">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="#D1FAE5"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#A7F3D0"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Совпадает"/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FECACA"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Расхождение"/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ScheduleOnly">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="#FEF3C7"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FDE68A"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Только спец."/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="CodeOnly">
                                                                        <Setter TargetName="StatusBadge" Property="Background" Value="#DBEAFE"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#BFDBFE"/>
                                                                        <Setter TargetName="StatusBadge" Property="BorderThickness" Value="1"/>
                                                                        <Setter TargetName="StatusText" Property="Text" Value="Только код"/>
                                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#1E40AF"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               x:Name="NoDataTextBlock"
                               Text="Нет данных для сравнения."
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="0,24,0,0">
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,160,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Content="Закрыть" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,0,0" Padding="32,0" IsCancel="True" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
            <local:LoadingOverlay x:Name="LoaderOverlay" Grid.RowSpan="6" Panel.ZIndex="1000"/>
        </Grid>
    </Border>
</Window>
