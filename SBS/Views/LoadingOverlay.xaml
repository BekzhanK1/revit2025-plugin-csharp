<UserControl x:Class="SmartRemont.ExportRooms.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartRemont.ExportRooms.Views"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="OverlayLogoImage" Width="200" Height="60" Stretch="Uniform" Margin="0,0,0,24"/>
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" BorderThickness="0" Background="#E2E8F0" Foreground="{StaticResource AppPrimaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
