<Window x:Class="SmartRemont.ExportRooms.Views.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont"
        Width="460"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource CardBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Выделяемый текст без рамки — сообщение можно скопировать -->
            <Style x:Key="SelectableText" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="SelectionBrush" Value="{StaticResource AppPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,28,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconTile"
                    Width="44" Height="44"
                    CornerRadius="22"
                    Background="{StaticResource InfoSoftBrush}"
                    VerticalAlignment="Top"
                    Margin="0,0,16,0">
                <TextBlock x:Name="IconGlyph"
                           Style="{StaticResource IconGlyph}"
                           FontSize="20"
                           Text="&#xE946;"
                           Foreground="{StaticResource InfoBrush}"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <ScrollViewer MaxHeight="340"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="MessageText"
                             Style="{StaticResource SelectableText}"
                             FontSize="13"
                             Foreground="{StaticResource TextSecondaryBrush}"/>
                </ScrollViewer>

                <Border x:Name="DetailsPanel"
                        Style="{StaticResource InsetPanel}"
                        Padding="12,10"
                        Margin="0,14,0,0">
                    <ScrollViewer MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBox x:Name="DetailsText"
                                 Style="{StaticResource SelectableText}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TertiaryButton"
                        Style="{StaticResource ModernSecondaryButton}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="TertiaryButton_Click"/>
                <Button x:Name="SecondaryButton"
                        Style="{StaticResource ModernSecondaryButton}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="SecondaryButton_Click"/>
                <Button x:Name="OkButton"
                        Content="OK"
                        Style="{StaticResource ModernPrimaryButton}"
                        MinWidth="104"
                        IsDefault="True"
                        Click="OkButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
