<Window x:Class="SmartRemont.ExportRooms.Views.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont"
        Width="400"
        MinWidth="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="#F5F5F5">

    <Border Background="White"
            CornerRadius="8"
            Margin="20"
            Padding="32,36"
            HorizontalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center">
            <Grid x:Name="SuccessIconPanel"
                  Width="72" Height="72"
                  Margin="0,0,0,20"
                  HorizontalAlignment="Center"
                  Visibility="Collapsed">
                <Ellipse Fill="#16A34A"/>
                <Path Data="M22,38 L32,48 L50,28"
                      Stroke="White"
                      StrokeThickness="4"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
            </Grid>

            <Grid x:Name="DevelopmentIconPanel"
                  Width="72" Height="72"
                  Margin="0,0,0,20"
                  HorizontalAlignment="Center"
                  Visibility="Collapsed">
                <Ellipse Fill="#F59E0B"/>
                <TextBlock Text="&#xE90F;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="32"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="TitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1B"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="MessageText"
                       FontSize="15"
                       Foreground="#333333"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="DetailsText"
                       FontSize="13"
                       Foreground="#888888"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,24"/>

            <Button x:Name="OkButton"
                    Content="OK"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Center"
                    IsDefault="True"
                    Foreground="White"
                    Background="#1B6FC8"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="OkButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1558A8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#124A8F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
