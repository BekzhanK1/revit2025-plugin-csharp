<Window x:Class="SmartRemont.ExportRooms.Views.ScheduleMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:services="clr-namespace:SmartRemont.ExportRooms.Services"
        Title="Настройки маппинга"
        Width="1040" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="ParseModeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="services:RoomMeasurementsScheduleMapping+ParseMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <Style x:Key="ChipBorder" TargetType="Border">
                <Setter Property="Background" Value="#EEF2FF"/>
                <Setter Property="BorderBrush" Value="#C7D2FE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>

            <Style x:Key="ChipRemoveButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="✕" Foreground="{TemplateBinding Foreground}" FontSize="11" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EmptyHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>

            <Style x:Key="PickerCard" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Настройки маппинга" Style="{StaticResource Heading1}"/>
            <TextBlock Text="Только выбор из списков проекта Revit — без ручного ввода названий." Style="{StaticResource BodyText}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: params -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ПАРАМЕТРЫ" Style="{StaticResource SectionLabel}" Margin="16,16,16,8"/>

                    <ListBox x:Name="EntriesListBox" Grid.Row="1"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="#F1F5F9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding ParamName}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding ParamCode}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="+ Добавить параметр"
                            Command="{Binding AddEntryCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="12"/>
                </Grid>
            </Border>

            <!-- RIGHT: editor -->
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                <Grid>
                    <TextBlock Text="Выберите параметр слева"
                               Foreground="#94A3B8" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedEntry}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <TextBlock Text="ПАРАМЕТР СИСТЕМЫ" Style="{StaticResource SectionGroupHeader}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Код параметра" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.KnownParamCodes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding ParamCode, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource FilterComboBox}"
                                              IsEditable="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Название в UI" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.KnownParamNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding ParamName, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource FilterComboBox}"
                                              IsEditable="False"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Режим чтения" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource ParseModeEnum}}"
                                          SelectedItem="{Binding Mode}"
                                          Style="{StaticResource FilterComboBox}"
                                          Width="280" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- SCHEDULES -->
                            <TextBlock Text="ВЕДОМОСТИ REVIT" Style="{StaticResource SectionGroupHeader}"/>
                            <Border Style="{StaticResource PickerCard}">
                                <StackPanel>
                                    <TextBlock Text="Добавить спецификацию из проекта" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableSchedules, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.SelectedAvailableSchedule, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource FilterComboBox}"/>
                                        <Button Grid.Column="2" Content="Добавить"
                                                Command="{Binding DataContext.PickScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" Padding="14,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Выбрано" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding Schedules}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipBorder}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#312E81" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource ChipRemoveButton}"
                                                        Command="{Binding DataContext.RemoveScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Убрать"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Ничего не выбрано — добавьте спецификацию выше">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Schedules.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- COLUMNS -->
                            <TextBlock Text="КОЛОНКИ ВЕДОМОСТИ" Style="{StaticResource SectionGroupHeader}" Margin="0,8,0,0"/>
                            <Border Style="{StaticResource PickerCard}">
                                <StackPanel>
                                    <TextBlock Text="Колонка из выбранной спецификации" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                    <TextBlock Text="Сначала выберите ведомость в списке выше — подтянутся её заголовки."
                                               FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"
                                               TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.SelectedAvailableColumn, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource FilterComboBox}"/>
                                        <Button Grid.Column="2" Content="+ Значения"
                                                Command="{Binding DataContext.PickValueColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" Padding="10,0"
                                                ToolTip="Колонка с числовым значением"/>
                                        <Button Grid.Column="4" Content="+ Помещение"
                                                Command="{Binding DataContext.PickRoomColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" Padding="10,0"
                                                ToolTip="Колонка с именем комнаты"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Колонки значений" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding ValueColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipBorder}" Background="#ECFDF5" BorderBrush="#A7F3D0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#065F46" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource ChipRemoveButton}" Foreground="#059669"
                                                                Command="{Binding DataContext.RemoveValueColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Колонки «Помещение»" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding RoomColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipBorder}" Background="#FFF7ED" BorderBrush="#FED7AA">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#9A3412" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource ChipRemoveButton}" Foreground="#C2410C"
                                                                Command="{Binding DataContext.RemoveRoomColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <!-- FILTERS -->
                            <TextBlock Text="ФИЛЬТР КОМНАТ" Style="{StaticResource SectionGroupHeader}" Margin="0,8,0,0"/>
                            <Border Style="{StaticResource PickerCard}">
                                <StackPanel>
                                    <TextBlock Text="Комната из модели Revit" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableRooms, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.SelectedAvailableRoom, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource FilterComboBox}"/>
                                        <Button Grid.Column="2" Content="+ Включать"
                                                Command="{Binding DataContext.PickFilterRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" Padding="10,0"/>
                                        <Button Grid.Column="4" Content="+ Исключать"
                                                Command="{Binding DataContext.PickExcludeRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" Padding="10,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Только эти комнаты" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding IncludeRooms}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipBorder}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#312E81" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource ChipRemoveButton}"
                                                                Command="{Binding DataContext.RemoveIncludeRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Исключить комнаты" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding ExcludeRooms}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipBorder}" Background="#FEF2F2" BorderBrush="#FECACA">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#991B1B" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource ChipRemoveButton}" Foreground="#DC2626"
                                                                Command="{Binding DataContext.RemoveExcludeRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Фиксированная комната (для SingleValueToFixedRoom)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding DataContext.AvailableRoomsWithEmpty, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding FixedRoomName, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource FilterComboBox}"
                                          Width="280" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <CheckBox Content="Целое число (без десятичных)" IsChecked="{Binding ValueIsInteger}" Margin="0,0,0,10"/>
                            <CheckBox Content="Составной параметр (сложение нескольких колонок / источников)"
                                      IsChecked="{Binding IsMergedParameter}" Margin="0,0,0,8"
                                      ToolTip="Например WALL_AREA_MINUS из нескольких ведомостей"/>

                            <Button Content="Удалить параметр"
                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Foreground="#DC2626" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" Margin="0,20,0,0" Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Сброс по умолчанию" Click="ResetButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="CancelButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                <Button Content="Сохранить" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
