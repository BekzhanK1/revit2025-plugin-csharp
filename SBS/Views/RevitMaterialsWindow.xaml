<Window x:Class="SmartRemont.ExportRooms.Views.RevitMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Синхронизация материалов"
        Width="{x:Static views:WindowLayoutHelper.HubDefaultWidth}"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F0F2F5">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#555555"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MaterialsDataGrid" TargetType="DataGrid">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinRowHeight" Value="40"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>

            <Style x:Key="WrapCellText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatusInProject" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#16A34A"/>
            </Style>

            <Style x:Key="StatusNotInProject" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9CA3AF"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Синхронизация материалов из Revit"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Загрузка RFA и surface-типов по SR_ID."
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock x:Name="ClientRequestTextBlock"
                       Grid.Row="1"
                       FontSize="12"
                       Foreground="#6B7280"
                       Margin="0,0,0,12"
                       Visibility="Collapsed"/>

            <Border Grid.Row="2"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="0,8,0,0">
                <Grid MinHeight="240">
                    <StackPanel x:Name="LoadingPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Visible">
                        <ProgressBar Width="120"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Margin="0,0,0,10"/>
                        <TextBlock Text="Загрузка..."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="EmptyTextBlock"
                               Text="Нет материалов для синхронизации."
                               FontSize="13"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="ErrorPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="ErrorTextBlock"
                                   FontSize="13"
                                   Foreground="#991B1B"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="520"
                                   Margin="0,0,0,12"/>
                        <Button x:Name="RetryButton"
                                Content="Повторить"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center"
                                Click="RetryButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="MaterialsDataGrid"
                              Style="{StaticResource MaterialsDataGrid}"
                              Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding MaterialIdDisplay}"
                                                Width="72"/>
                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding MaterialName}"
                                                Width="*"
                                                MinWidth="240">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Тип"
                                                Binding="{Binding TypeDisplay}"
                                                Width="140"/>
                            <DataGridTemplateColumn Header="Статус" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProjectStatusDisplay}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInProject}" Value="True">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="SyncProgressPanel"
                            Grid.Row="0"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                    <TextBlock x:Name="SyncProgressTextBlock"
                               FontSize="12"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>
                    <ProgressBar x:Name="SyncProgressBar"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SyncButton"
                            Grid.Column="0"
                            Content="Синхронизировать"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0"
                            IsEnabled="False"
                            Click="SyncButton_Click"/>
                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"/>
                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Content="Закрыть"
                            Style="{StaticResource SecondaryButton}"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
