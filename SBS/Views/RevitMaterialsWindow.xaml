<Window x:Class="SmartRemont.ExportRooms.Views.RevitMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Синхронизация материалов"
        MinWidth="900"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WrapCellText" TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextBase}"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE7B8;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Синхронизация материалов из Revit" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Загрузка RFA-семейств и surface-типов по SR_ID из Smart Remont." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="2"
                        Style="{StaticResource ChipInfo}"
                        Margin="16,0,0,0"
                        Visibility="{Binding Visibility, ElementName=ClientRequestTextBlock}">
                    <TextBlock x:Name="ClientRequestTextBlock"
                               Style="{StaticResource ChipText}"
                               Foreground="{StaticResource InfoTextBrush}"
                               Visibility="Collapsed"/>
                </Border>
            </Grid>
        </Border>

        <!-- BODY -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="28,20,28,20">
            <Grid MinHeight="300">
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                    <ProgressBar Width="200" Height="4" IsIndeterminate="True" Margin="0,0,0,14"/>
                    <TextBlock Text="Загрузка списка материалов…" Style="{StaticResource EmptyStateText}"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Visibility, ElementName=EmptyTextBlock}">
                    <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EmptyTextBlock" Text="Нет материалов для синхронизации." Style="{StaticResource EmptyStateText}" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Visibility="Collapsed">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource ErrorBackgroundBrush}" Margin="0,0,0,14">
                        <TextBlock Text="&#xE783;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{StaticResource ErrorBrush}"/>
                    </Border>
                    <TextBlock x:Name="ErrorTextBlock" FontSize="13" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Button x:Name="RetryButton" Style="{StaticResource ModernSecondaryButton}" HorizontalAlignment="Center" Click="RetryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Повторить загрузку" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            <Grid x:Name="DataPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentBar}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MaterialsTab"
                                         GroupName="MaterialTabs"
                                         Style="{StaticResource SegmentTab}"
                                         IsChecked="True"
                                         ToolTip="Материалы ТК заявки: они загружаются в проект"
                                         Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Материалы ТК" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource SegmentCount}">
                                        <TextBlock x:Name="MaterialsTabCountText" Text="—" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MissingTab"
                                         GroupName="MaterialTabs"
                                         Style="{StaticResource SegmentTab}"
                                         ToolTip="Конструктивы эталонного пакета (или подбора заявки), которых нет в ТК"
                                         Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Нет в ТК" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource SegmentCount}" Background="{StaticResource WarningSoftBrush}">
                                        <TextBlock x:Name="MissingTabCountText" Text="—" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarningTextBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ExtraTab"
                                         GroupName="MaterialTabs"
                                         Style="{StaticResource SegmentTab}"
                                         ToolTip="Элементы проекта с SR_ID, которого нет в ТК заявки"
                                         Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Не из ТК в проекте" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource SegmentCount}" Background="{StaticResource ErrorBackgroundBrush}">
                                        <TextBlock x:Name="ExtraTabCountText" Text="—" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ErrorTextBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CompareSourceTextBlock"
                               Grid.Column="1"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <Border x:Name="MissingCallout" Grid.Row="1" Style="{StaticResource CalloutInfo}" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource CalloutIcon}" Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock x:Name="MissingCalloutText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}"/>
                    </Grid>
                </Border>

                <Border x:Name="ExtraCallout" Grid.Row="1" Style="{StaticResource CalloutWarning}" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource CalloutIcon}" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock x:Name="ExtraCalloutText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningTextBrush}"
                                   Text="Этих SR_ID нет в ТК заявки. Плагин их не удаляет: размещённые замените в модели на материал из ТК."/>
                    </Grid>
                </Border>

            <DataGrid x:Name="MaterialsDataGrid"
                              Grid.Row="2"
                              Style="{StaticResource ModernDataGrid}"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding MaterialIdDisplay}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SR_ID в Revit" Binding="{Binding SrIdInRevitDisplay}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Название" Binding="{Binding MaterialName}" Width="*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Название в Revit" Binding="{Binding RevitNameDisplay}" Width="*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Тип" Binding="{Binding TypeDisplay}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Статус" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,2" CornerRadius="999" BorderThickness="1" HorizontalAlignment="Left"
                                                ToolTip="{Binding DetailDisplay}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSyncError}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInProject}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ProjectStatusDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSyncError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInProject}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Подбор / наличие" Width="1.5*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,2" CornerRadius="10" BorderThickness="1" HorizontalAlignment="Left"
                                                ToolTip="{Binding TkFlagDisplay}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TkFlagTone}" Value="Mute">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TkFlagTone}" Value="Warn">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TkFlagTone}" Value="Bad">
                                                            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TkFlagDisplay}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TkFlagTone}" Value="Mute">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TkFlagTone}" Value="Warn">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TkFlagTone}" Value="Bad">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Детали" Binding="{Binding DetailDisplay}" Width="2*" MinWidth="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSyncError}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                <DataGrid x:Name="MissingDataGrid"
                          Grid.Row="2"
                          Style="{StaticResource ModernDataGrid}"
                          Visibility="Collapsed"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Auto"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Комната" Binding="{Binding RoomDisplay}" Width="*" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Конструктив" Binding="{Binding WorkSetDisplay}" Width="1.5*" MinWidth="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Материал в пакете" Binding="{Binding KitMaterialDisplay}" Width="2*" MinWidth="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Почему" Binding="{Binding KindDisplay}" Width="1.5*" MinWidth="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="ExtraDataGrid"
                          Grid.Row="2"
                          Style="{StaticResource ModernDataGrid}"
                          Visibility="Collapsed"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Auto"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SR_ID" Binding="{Binding SrIdDisplay}" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Название в Revit" Binding="{Binding Label}" Width="2*" MinWidth="240" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Вид" Binding="{Binding KindDisplay}" Width="*" MinWidth="160" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Использование" Binding="{Binding UsageDisplay}" Width="1.5*" MinWidth="200" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TabEmptyTextBlock"
                           Grid.Row="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           Style="{StaticResource EmptyStateText}"
                           Visibility="Collapsed"/>
            </Grid>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="SyncProgressPanel" Grid.Row="0" Margin="0,2,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="SyncProgressTextBlock" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="SyncProgressBar" Height="6" Minimum="0" Maximum="1" Value="0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,20,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CloseButton" Content="Закрыть" Style="{StaticResource ModernSecondaryButton}" MinWidth="110" Margin="0,0,10,0" IsCancel="True" Click="CloseButton_Click"/>
                        <Button x:Name="SyncButton" Style="{StaticResource ModernPrimaryButton}" MinWidth="170" IsEnabled="False" Click="SyncButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Синхронизировать" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
