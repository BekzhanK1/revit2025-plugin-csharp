<UserControl x:Class="SmartRemont.ExportRooms.Views.ProcessStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Этап процесса: слева кружок со статусом и линия к следующему этапу, справа содержимое. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="IndicatorCircle"
                    Width="30" Height="30"
                    CornerRadius="15"
                    BorderThickness="2"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}">
                <Grid>
                    <TextBlock x:Name="IndicatorNumber"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="IndicatorGlyph"
                               Style="{StaticResource IconGlyph}"
                               FontSize="13"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="Connector"
                    Grid.Row="1"
                    Width="2"
                    HorizontalAlignment="Left"
                    Margin="14,4,0,-6"
                    CornerRadius="1"
                    Background="{StaticResource DividerBrush}"/>
        </Grid>

        <Border x:Name="ContentHost"
                Grid.Column="1"
                CornerRadius="10"
                BorderThickness="1"
                Padding="16,12"
                Margin="0,0,0,12"
                Background="Transparent"
                BorderBrush="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Border x:Name="ChipBorder"
                            CornerRadius="999"
                            Padding="9,2"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ChipText"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="HintText"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,16,0"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,4,0,0">
                    <Button x:Name="SecondaryButton"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="SecondaryButton_Click"/>
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource CompactPrimaryButton}"
                            Visibility="Collapsed"
                            Click="PrimaryButton_Click"/>
                </StackPanel>

                <!-- Дополнительное содержимое этапа (путь к проекту, ссылки) -->
                <ContentPresenter x:Name="ExtraContent"
                                  Grid.Row="2"
                                  Grid.Column="0"
                                  Margin="0,8,16,0"
                                  Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
