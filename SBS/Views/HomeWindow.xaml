<Window x:Class="SmartRemont.ExportRooms.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont"
        Width="{x:Static views:WindowLayoutHelper.HomeDefaultWidth}"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style x:Key="ResultItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,14">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="28" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Smart Remont"
                               Style="{StaticResource Heading1}"/>
                    <TextBlock x:Name="WelcomeTextBlock"
                               Style="{StaticResource BodyText}"/>
                </StackPanel>
                <Button x:Name="LogoutButton"
                        Content="Выйти"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        Click="LogoutButton_Click"/>
            </Grid>

            <!-- Bound remont banner -->
            <Border Grid.Row="1"
                    x:Name="BoundRemontBanner"
                    Background="#ECFDF5"
                    BorderBrush="#10B981"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheckCircle}" 
                                  Fill="#10B981" 
                                  Width="18" Height="18" 
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock x:Name="BoundRemontBannerText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#065F46"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="ContinueToHubButton"
                            Content="Продолжить"
                            Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="140"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Click="ContinueToHubButton_Click"/>
                </Grid>
            </Border>

            <!-- Search -->
            <Border Grid.Row="2"
                    x:Name="SearchSection"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,20"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="ПОИСК ЗАЯВКИ" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="ID заявки"
                               Style="{StaticResource FieldLabel}"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="IdTextBox"
                                     Style="{StaticResource ModernInputField}"
                                     KeyDown="IdTextBox_KeyDown"
                                     TextChanged="IdTextBox_TextChanged"
                                     GotFocus="IdTextBox_GotFocus"
                                     LostFocus="IdTextBox_LostFocus"/>
                            <TextBlock x:Name="IdPlaceholderTextBlock"
                                       Text="Введите ID заявки (например, 100234)"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="14"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="SearchProgressBar"
                                     Grid.Column="1"
                                     Width="72"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Center"
                                     Margin="12,0,0,0"
                                     Foreground="{StaticResource AppPrimaryBrush}"
                                     Background="#E2E8F0"
                                     BorderThickness="0"/>
                        <Button x:Name="SearchButton"
                                Grid.Column="3"
                                Content="Найти"
                                Style="{StaticResource ModernPrimaryButton}"
                                MinWidth="100"
                                Click="SearchButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="2,12,0,0"
                               Text="Введите ID заявки и нажмите Найти или Enter"/>
                </StackPanel>
            </Border>

            <!-- Results list -->
            <Border Grid.Row="3"
                    x:Name="ResultsSection"
                    Margin="0,0,0,24"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="РЕЗУЛЬТАТЫ"
                               Style="{StaticResource SectionLabel}"/>

                    <ListBox Grid.Row="1"
                             x:Name="ResultsListBox"
                             ItemContainerStyle="{StaticResource ResultItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ResultsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ClientName}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#EFF6FF"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    Margin="0,0,8,0">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D4ED8">
                                                    <Run Text="Заявка #"/>
                                                    <Run Text="{Binding ClientRequestId}"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#F0FDF4"
                                                    CornerRadius="4"
                                                    Padding="8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemontId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#16A34A">
                                                    <Run Text="Ремонт #"/>
                                                    <Run Text="{Binding RemontId}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Actions -->
            <Grid Grid.Row="4">
                <Button Content="Отмена"
                        Style="{StaticResource ModernSecondaryButton}"
                        HorizontalAlignment="Right"
                        MinWidth="100"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
