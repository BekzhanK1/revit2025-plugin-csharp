<Window x:Class="SmartRemont.ExportRooms.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont"
        Height="620" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="36,32"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBlock" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,32,0"/>
            <Setter Property="Padding" Value="4,6"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B6FC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#155BB0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <TextBlock Text="Smart Remont"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1B1B1B"
                           VerticalAlignment="Center"/>
                <Button x:Name="LogoutButton"
                        Content="Выйти"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="LogoutButton_Click"/>
            </Grid>

            <!-- Welcome -->
            <TextBlock Grid.Row="1"
                       x:Name="WelcomeTextBlock"
                       FontSize="17"
                       LineHeight="26"
                       Foreground="#333333"
                       TextWrapping="Wrap"
                       Margin="0,0,0,32"/>

            <!-- Search -->
            <Border Grid.Row="2" Style="{StaticResource SectionBlock}">
                <StackPanel>
                    <TextBlock Text="ПОИСК РЕМОНТА" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton x:Name="ByRemontIdRadio"
                                     Content="ID ремонта"
                                     GroupName="SearchMode"
                                     IsChecked="True"/>
                        <RadioButton x:Name="ByClientRequestIdRadio"
                                     Content="ID заявки"
                                     GroupName="SearchMode"
                                     Margin="0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IdTextBox"
                                 Grid.Column="0"
                                 Margin="0,0,12,0"
                                 KeyDown="IdTextBox_KeyDown"/>
                        <Button x:Name="SearchButton"
                                Grid.Column="1"
                                Content="Найти"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="110"
                                Click="SearchButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Result (fills remaining space) -->
            <Border Grid.Row="3"
                    Style="{StaticResource SectionBlock}"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="РЕЗУЛЬТАТ"
                               Style="{StaticResource SectionLabel}"/>

                    <ComboBox Grid.Row="1"
                              x:Name="RemontComboBox"
                              DisplayMemberPath="Name"
                              IsEnabled="False"
                              MinHeight="44"
                              Margin="0,0,0,16"
                              SelectionChanged="RemontComboBox_SelectionChanged"/>

                    <TextBlock Grid.Row="3"
                               x:Name="StatusTextBlock"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="#999999"
                               TextWrapping="Wrap"
                               Text="Введите ID и нажмите «Найти»"/>
                </Grid>
            </Border>

            <!-- Confirmed selection -->
            <Border Grid.Row="4"
                    x:Name="SelectedPanel"
                    Background="#EEF4FC"
                    CornerRadius="6"
                    Padding="16,14"
                    Margin="0,0,0,28"
                    Visibility="Collapsed">
                <TextBlock x:Name="SelectedTextBlock"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="#1B6FC8"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Actions -->
            <Grid Grid.Row="5">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="SelectButton"
                            Content="Выбрать"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"
                            IsEnabled="False"
                            Click="SelectButton_Click"/>
                    <Button x:Name="ContinueButton"
                            Content="Продолжить"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            IsEnabled="False"
                            Click="ContinueButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
