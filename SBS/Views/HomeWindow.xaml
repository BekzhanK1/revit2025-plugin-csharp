<Window x:Class="SmartRemont.ExportRooms.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont"
        Height="320" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="#F5F5F5">
    <Border Background="White"
            CornerRadius="8"
            Margin="20"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Smart Remont"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1B"
                       Margin="0,0,0,16"/>

            <TextBlock Grid.Row="1"
                       x:Name="WelcomeTextBlock"
                       FontSize="16"
                       Foreground="#333333"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24"/>

            <TextBlock Grid.Row="2"
                       Text="Выберите ремонт"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       Margin="0,0,0,8"/>

            <ComboBox Grid.Row="3"
                      x:Name="RemontComboBox"
                      Height="36"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,8"/>

            <TextBlock Grid.Row="4"
                       x:Name="HintTextBlock"
                       Text="Список ремонтов — тестовые данные"
                       FontSize="11"
                       Foreground="#999999"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="100"
                        Height="34"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button x:Name="ContinueButton"
                        Content="Продолжить"
                        Width="120"
                        Height="34"
                        IsDefault="True"
                        Click="ContinueButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
