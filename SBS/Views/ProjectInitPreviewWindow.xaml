<Window x:Class="SmartRemont.ExportRooms.Views.ProjectInitPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Предпросмотр инициализации"
        Width="{x:Static views:WindowLayoutHelper.HubDefaultWidth}"
        MinWidth="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="#F0F2F5">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#555555"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PreviewDataGrid" TargetType="DataGrid">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinRowHeight" Value="40"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>

            <Style x:Key="WrapCellText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Предпросмотр инициализации"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock x:Name="SubtitleTextBlock"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ФАЙЛ ПРОЕКТА"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TargetPathTextBlock"
                               FontSize="13"
                               Foreground="#1F2937"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="OverwriteWarningTextBlock"
                               FontSize="12"
                               Foreground="#B45309"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="StepsTextBlock"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="МАТЕРИАЛЫ ДЛЯ ЗАГРУЗКИ"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="3"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="0,8,0,0">
                <Grid MinHeight="220">
                    <TextBlock x:Name="EmptyTextBlock"
                               Text="Нет материалов для загрузки."
                               FontSize="13"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <DataGrid x:Name="MaterialsDataGrid"
                              Style="{StaticResource PreviewDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding MaterialIdDisplay}"
                                                Width="72"/>
                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding MaterialName}"
                                                Width="*"
                                                MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Тип"
                                                Binding="{Binding TypeDisplay}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Файл"
                                                Binding="{Binding FileTypeDisplay}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Asset"
                                                Binding="{Binding AssetDisplay}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <TextBlock x:Name="SummaryTextBlock"
                           FontSize="13"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,240,0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="InitButton"
                            Content="Инициализировать"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Click="InitButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
