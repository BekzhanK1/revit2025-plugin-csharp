<Window x:Class="SmartRemont.ExportRooms.Views.ProjectInitPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Предпросмотр инициализации"
        MinWidth="880"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PreviewDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinRowHeight" Value="36"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="views:ScrollBehavior.BubbleMouseWheel" Value="True"/>
            </Style>

            <Style x:Key="WrapCellText" TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextBase}"/>

            <Style x:Key="PreviewGroupRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CategoryKey}" Value="NoModel">
                        <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CategoryKey}" Value="MissingMarkup">
                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE8F4;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Предпросмотр инициализации" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="SubtitleTextBlock" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="28,24,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: файл, шаги, проверка -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource ContentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Файл проекта" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InsetPanel}" Padding="12,10">
                                <TextBlock x:Name="TargetPathTextBlock"
                                           FontSize="12"
                                           FontFamily="Consolas, Segoe UI"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock x:Name="OverwriteWarningTextBlock"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ContentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE9D5;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Что произойдёт" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <TextBlock x:Name="StepsTextBlock"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ValidationWarningBorder"
                            Style="{StaticResource CalloutError}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource CalloutIcon}" Foreground="{StaticResource ErrorBrush}"/>
                            <TextBlock x:Name="ValidationIssuesTextBlock"
                                       Grid.Column="1"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="{StaticResource ErrorTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Правая колонка: материалы -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Материалы для загрузки" Style="{StaticResource CardTitle}"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyTextBlock"
                                   Text="Нет материалов для загрузки."
                                   Style="{StaticResource EmptyStateText}"
                                   Margin="24"
                                   Visibility="Collapsed"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MaterialGroupsItemsControl" Margin="20,16,20,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,20">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource CaptionText}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource Chip}"
                                                        VerticalAlignment="Top"
                                                        Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding SummaryBadge}" Style="{StaticResource ChipText}"/>
                                                </Border>
                                            </Grid>

                                            <DataGrid ItemsSource="{Binding Rows}"
                                                      Style="{StaticResource PreviewDataGrid}"
                                                      RowStyle="{StaticResource PreviewGroupRowStyle}"
                                                      MinHeight="40">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID"
                                                                        Binding="{Binding MaterialIdDisplay}"
                                                                        Width="72">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Название"
                                                                        Binding="{Binding MaterialName}"
                                                                        Width="*"
                                                                        MinWidth="180">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Примечание"
                                                                        Binding="{Binding DetailDisplay}"
                                                                        Width="240"
                                                                        MinWidth="160">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="PreDownloadStatusTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="SummaryTextBlock"
                               Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="IgnoreValidationButton"
                            Content="Всё равно продолжить"
                            Style="{StaticResource DangerGhostButton}"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="IgnoreValidationButton_Click"/>
                    <Button Content="Отмена"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="InitButton"
                            Content="Инициализировать"
                            Style="{StaticResource ModernPrimaryButton}"
                            Padding="22,0"
                            IsDefault="True"
                            Click="InitButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
