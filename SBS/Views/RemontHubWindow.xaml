<Window x:Class="SmartRemont.ExportRooms.Views.RemontHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Заявка"
        Width="1040"
        MinWidth="900"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SideCardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="HeaderMetaSeparator" TargetType="TextBlock">
                <Setter Property="Text" Value="·"/>
                <Setter Property="Margin" Value="8,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: заявка, клиент, обновить -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource HeaderIconTile}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE80F;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock x:Name="ClientRequestIdHeroText"
                                   Style="{StaticResource PageTitle}"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Border Style="{StaticResource ChipInfo}" Margin="0,0,8,0">
                            <Border.Visibility>
                                <Binding ElementName="RemontIdHeroText" Path="Visibility"/>
                            </Border.Visibility>
                            <TextBlock x:Name="RemontIdHeroText"
                                       Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource InfoTextBrush}"/>
                        </Border>
                    </WrapPanel>

                    <!-- Клиент · ЖК · квартира · пакет -->
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="ClientNameText" Style="{StaticResource PageSubtitle}" Margin="0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Style="{StaticResource HeaderMetaSeparator}"/>
                        <TextBlock x:Name="ResidentNameText" Style="{StaticResource PageSubtitle}" Margin="0"/>
                        <TextBlock Style="{StaticResource HeaderMetaSeparator}"/>
                        <TextBlock x:Name="FlatNumText" Style="{StaticResource PageSubtitle}" Margin="0"/>
                        <TextBlock Style="{StaticResource HeaderMetaSeparator}"/>
                        <TextBlock x:Name="PresetNameText" Style="{StaticResource PageSubtitle}" Margin="0"/>
                    </WrapPanel>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Style="{StaticResource CompactSecondaryButton}"
                        Height="34"
                        VerticalAlignment="Center"
                        ToolTip="Перечитать статусы из MySpace — например, после утверждения ДС"
                        Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock x:Name="RefreshButtonText" Text="Обновить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Image x:Name="CompanyLogoImage"
                       Grid.Column="3"
                       MaxHeight="34"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- BODY: процесс слева, проект и материалы справа -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- ПРОЦЕСС -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="24,20,24,10" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <!-- 5 кликов по заголовку до инициализации открывают «Привязать без шаблона». -->
                                <TextBlock x:Name="FunctionsSectionLabel"
                                           Text="ПРОЦЕСС ПО ЗАЯВКЕ"
                                           Style="{StaticResource SectionLabel}"
                                           Background="Transparent"
                                           Margin="0,0,0,2"
                                           MouseLeftButtonUp="FunctionsSectionLabel_MouseLeftButtonUp"/>
                                <TextBlock Text="Этапы идут строго по порядку: следующий откроется, когда пройден предыдущий."
                                           Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource ChipPrimary}" VerticalAlignment="Top">
                                <TextBlock x:Name="ProcessProgressText"
                                           Style="{StaticResource ChipText}"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Проект утверждён: всё только для чтения -->
                        <Border x:Name="ProjectApprovedOverlay"
                                Style="{StaticResource CalloutError}"
                                Padding="14,10"
                                Margin="0,0,0,14"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;"
                                           Style="{StaticResource IconGlyph}"
                                           FontSize="14"
                                           Foreground="{StaticResource ErrorTextBrush}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="Проект утверждён — изменения заблокированы"
                                           Foreground="{StaticResource ErrorTextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <views:ProcessStepView x:Name="StepProject" Number="1" Title="Проект"/>
                        <views:ProcessStepView x:Name="StepDsArea" Number="2" Title="ДС на изменение квадратуры"/>
                        <views:ProcessStepView x:Name="StepMeasures" Number="3" Title="Замеры комнат"/>
                        <views:ProcessStepView x:Name="StepDsTk" Number="4" Title="ДС на изменение ТК" IsLast="True"/>
                    </StackPanel>
                </Border>

                <!-- ПРАВАЯ КОЛОНКА -->
                <StackPanel Grid.Column="2">

                    <!-- Проект -->
                    <Border x:Name="InitializedProjectPanel"
                            Style="{StaticResource ModernCard}"
                            Padding="18,16"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ФАЙЛ ПРОЕКТА" Style="{StaticResource SideCardTitle}" Margin="0"/>
                                <Border x:Name="ProjectInitializedBadge"
                                        Grid.Column="1"
                                        Style="{StaticResource ChipSuccess}"
                                        Padding="8,1"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ProjectInitializedBadgeText"
                                               Style="{StaticResource ChipText}"
                                               FontSize="11"
                                               Foreground="{StaticResource SuccessTextBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="InitializedProjectPathText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="InitializedProjectMetaText"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,12"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="OpenProjectFolderButton"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Margin="0,0,8,8"
                                        Click="OpenProjectFolderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Папка" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ResyncMaterialsButton"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Margin="0,0,0,8"
                                        ToolTip="Заново загрузить материалы ТК в этот проект"
                                        Click="ResyncMaterialsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Перезагрузить материалы" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Материалы Revit -->
                    <Border x:Name="MaterialsPanel"
                            Style="{StaticResource ModernCard}"
                            Padding="18,16"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="МАТЕРИАЛЫ REVIT" Style="{StaticResource SideCardTitle}"/>
                            <Border x:Name="MaterialsChip"
                                    Style="{StaticResource Chip}"
                                    HorizontalAlignment="Left"
                                    Padding="9,2"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="MaterialsChipText" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="MaterialsHintText"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0"
                                       Text="Модели материалов ТК: какие уже в проекте, каких нет."/>
                            <Button x:Name="RevitMaterialsButton"
                                    Style="{StaticResource CompactSecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Click="RevitMaterialsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Открыть материалы" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Скрытые функции (на потом) -->
                    <Border x:Name="ToolsPanel"
                            Style="{StaticResource ModernCard}"
                            Padding="18,16"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="ИНСТРУМЕНТЫ" Style="{StaticResource SideCardTitle}"/>
                            <Button x:Name="MeasuresFromCodeButton"
                                    Content="Замеры по коду"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Click="MeasuresFromCodeButton_Click"/>
                            <Button x:Name="MeasuresCompareButton"
                                    Content="Сравнение замеров"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Click="MeasuresCompareButton_Click"/>
                            <Button x:Name="TypeParametersButton"
                                    Content="Изменение параметров типов"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Click="TypeParametersButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="StatusBanner"
                        Style="{StaticResource CalloutInfo}"
                        Padding="12,8"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource CalloutIcon}" FontSize="14" Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock x:Name="StatusTextBlock"
                                   Grid.Column="1"
                                   FontSize="13"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Border x:Name="StatusPlainHost"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusPlainText"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="Закрыть"
                        Style="{StaticResource ModernSecondaryButton}"
                        MinWidth="110"
                        VerticalAlignment="Center"
                        IsCancel="True"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <views:LoadingOverlay x:Name="InitLoaderOverlay"
                              Grid.RowSpan="3"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Panel.ZIndex="1000"/>

        <!-- Обновление статусов: закрывает весь хаб, пока не придут ответы MySpace -->
        <views:LoadingOverlay x:Name="RefreshOverlay"
                              Grid.RowSpan="3"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Panel.ZIndex="900"/>
    </Grid>
</Window>
