<Window x:Class="SmartRemont.ExportRooms.Views.RemontHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Ремонт"
        Width="920"
        MinWidth="920"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HubInfoLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="HubInfoValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Modern Dashboard Button Card -->
            <Style x:Key="FeatureCardButton" TargetType="Button">
                <Setter Property="Margin" Value="0,0,16,16"/>
                <Setter Property="Height" Value="100"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBorder"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#E2E8F0" Duration="0:0:0.15"/>
                                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FFFFFF" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="#3B82F6" Duration="0:0:0.15"/>
                                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#F8FAFC" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="CardBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#F1F5F9" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Box -->
                                    <Border x:Name="IconHost"
                                            Grid.Column="0"
                                            Width="44" Height="44"
                                            CornerRadius="10"
                                            Background="#EFF6FF"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="FeatureIcon"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="#2563EB"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Text Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <TextBlock x:Name="FeatureTitle"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{TemplateBinding Content}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="FeatureSubtitle"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                Margin="0,12,0,0">
                                        
                                        <!-- Dynamic Status Badge -->
                                        <Border x:Name="DynamicBadge"
                                                Background="#F1F5F9"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="DynamicBadgeText"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"/>
                                        </Border>

                                        <!-- Explanation Text -->
                                        <TextBlock x:Name="StatusExplanationText"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="IconHost" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="FeatureIcon" Property="Foreground" Value="#94A3B8"/>
                                    <Setter TargetName="FeatureTitle" Property="Foreground" Value="#94A3B8"/>
                                    <Setter TargetName="FeatureSubtitle" Property="Foreground" Value="#CBD5E1"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="muted">
                                    <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="IconHost" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="FeatureIcon" Property="Foreground" Value="#64748B"/>
                                    <Setter TargetName="FeatureTitle" Property="Foreground" Value="#475569"/>
                                    <Setter TargetName="FeatureSubtitle" Property="Foreground" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <Image x:Name="CompanyLogoImage" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock x:Name="ClientRequestIdHeroText"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RemontIdHeroText"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#1D4ED8"/>
                            </Border>
                            
                            <!-- Project Badge inline -->
                            <Border x:Name="ProjectInitializedBadge"
                                    Background="#DCFCE7"
                                    BorderBrush="#BBF7D0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheckCircle}" 
                                          Fill="#10B981" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ProjectInitializedBadgeText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#166534"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="RemontNameText"
                                   Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- INFO BLOCK -->
                <Border Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24,20"
                        Margin="0,0,0,32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Client -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="КЛИЕНТ" Style="{StaticResource HubInfoLabel}"/>
                            <TextBlock x:Name="ClientNameText" Style="{StaticResource HubInfoValue}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource CardBorderBrush}" Margin="0,4,0,4"/>

                        <!-- Resident -->
                        <StackPanel Grid.Column="2" Margin="16,0,16,0">
                            <TextBlock Text="ЖК" Style="{StaticResource HubInfoLabel}"/>
                            <TextBlock x:Name="ResidentNameText" Style="{StaticResource HubInfoValue}"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{StaticResource CardBorderBrush}" Margin="0,4,0,4"/>

                        <!-- Flat -->
                        <StackPanel Grid.Column="4" Margin="16,0,16,0">
                            <TextBlock Text="КВАРТИРА" Style="{StaticResource HubInfoLabel}"/>
                            <TextBlock x:Name="FlatNumText" Style="{StaticResource HubInfoValue}"/>
                        </StackPanel>
                        <Border Grid.Column="5" Background="{StaticResource CardBorderBrush}" Margin="0,4,0,4"/>

                        <!-- Preset Kit -->
                        <StackPanel Grid.Column="6" Margin="16,0,0,0">
                            <TextBlock Text="ПАКЕТ" Style="{StaticResource HubInfoLabel}"/>
                            <TextBlock x:Name="PresetNameText" Style="{StaticResource HubInfoValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FUNCTIONS DASHBOARD -->
                <StackPanel Grid.Row="2" Margin="0,0,0,32">
                    <TextBlock x:Name="FunctionsSectionLabel"
                               Text="ФУНКЦИИ И ОПЕРАЦИИ"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <UniformGrid Columns="2" Rows="4">
                            <Button x:Name="InitProjectButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="Инициализировать проект"
                                    Tag="primary"
                                    Click="InitProjectButton_Click"/>
                            <Button x:Name="RevitMaterialsButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="Синхронизация материалов из Revit"
                                    Tag="primary"
                                    Click="RevitMaterialsButton_Click"/>
                            
                            <!-- Legacy/Muted functions to show -->
                            <Button x:Name="DsAreaChangeButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="ДС на изменение квадратуры"
                                    Tag="default"
                                    Click="DsAreaChangeButton_Click"/>
                            <Button x:Name="MeasuresButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="Замеры комнат (из спецификаций)"
                                    Tag="default"
                                    Click="MeasuresButton_Click"/>
                            <Button x:Name="RoomMaterialsButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="ДС на изменение ТК"
                                    Tag="default"
                                    Click="RoomMaterialsButton_Click"/>

                            <!-- Hidden functions (for later) -->
                            <Button x:Name="MeasuresFromCodeButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="Замеры по коду"
                                    Tag="default"
                                    Visibility="Collapsed"
                                    Click="MeasuresFromCodeButton_Click"/>
                            <Button x:Name="MeasuresCompareButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="Сравнение замеров"
                                    Tag="default"
                                    Visibility="Collapsed"
                                    Click="MeasuresCompareButton_Click"/>
                            <Button x:Name="TypeParametersButton"
                                    Style="{StaticResource FeatureCardButton}"
                                    Content="Изменение параметров типов"
                                    Tag="default"
                                    Visibility="Collapsed"
                                    Click="TypeParametersButton_Click"/>
                        </UniformGrid>

                        <Border x:Name="ProjectApprovedOverlay"
                                Background="#CCF8FAFC"
                                Visibility="Collapsed"
                                CornerRadius="12">
                            <Border Background="#FEE2E2" 
                                    BorderBrush="#FECACA" 
                                    BorderThickness="1" 
                                    Padding="16,10" 
                                    CornerRadius="6"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLock}" Fill="#991B1B" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Проект утвержден — внесение изменений заблокировано" 
                                               Foreground="#991B1B" 
                                               FontWeight="SemiBold" 
                                               FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- FOOTER ACTIONS -->
                <Grid Grid.Row="3">
                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,120,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            x:Name="StatusBanner">
                        <TextBlock x:Name="StatusTextBlock"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#1E40AF"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="StatusPlainHost"
                            Margin="0,0,120,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusPlainText"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource ModernSecondaryButton}"
                            HorizontalAlignment="Right"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
