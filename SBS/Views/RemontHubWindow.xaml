<Window x:Class="SmartRemont.ExportRooms.Views.RemontHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Ремонт"
        Width="760"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="32,28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FeatureCardButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="AccentBar"
                                        Grid.Column="0"
                                        CornerRadius="2"
                                        Margin="0,2,12,2"
                                        Background="#1B6FC8"/>

                                <Border Grid.Column="1"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="#EFF6FF"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="FeatureIcon"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="#1B6FC8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="FeatureTitle"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               Text="{TemplateBinding Content}"/>
                                    <TextBlock x:Name="FeatureSubtitle"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <Border x:Name="SentBadge"
                                            Background="#DBEAFE"
                                            BorderBrush="#BFDBFE"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="0,0,8,0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="SentBadgeText"
                                                   Text="Отправлено"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1D4ED8"/>
                                    </Border>
                                    <Border x:Name="SoonBadge"
                                            Background="#FEF3C7"
                                            BorderBrush="#FDE68A"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="0,0,8,0"
                                            Visibility="Collapsed">
                                        <TextBlock Text="Скоро"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#B45309"/>
                                    </Border>
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#1B6FC8"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="muted">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FAFAFA"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="#D1D5DB"/>
                                <Setter TargetName="FeatureIcon" Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Setter TargetName="SoonBadge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Image x:Name="CompanyLogoImage"
                       MaxHeight="44"
                       Margin="0,0,0,12"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed"/>
                <TextBlock Text="Ремонт"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock x:Name="RemontSubtitleText"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ID заявки" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ClientRequestIdText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="ID ремонта" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="RemontIdText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="Клиент" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ClientNameText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ЖК" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ResidentNameText" Style="{StaticResource InfoValue}" Margin="0,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Квартира" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="FlatNumText" Style="{StaticResource InfoValue}" Margin="0,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="Пакет" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="PresetNameText" Style="{StaticResource InfoValue}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="ФУНКЦИИ"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,10"/>

            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <Button x:Name="DsAreaChangeButton"
                        Style="{StaticResource FeatureCardButton}"
                        Content="ДС по изменению квадратуры"
                        Tag="primary"
                        Click="DsAreaChangeButton_Click"/>
                <Button x:Name="MeasuresButton"
                        Style="{StaticResource FeatureCardButton}"
                        Content="Замеры комнат"
                        Tag="default"
                        Click="MeasuresButton_Click"/>
                <Button x:Name="MeasuresFromCodeButton"
                        Style="{StaticResource FeatureCardButton}"
                        Content="Замеры по коду"
                        Tag="default"
                        Click="MeasuresFromCodeButton_Click"/>
                <Button x:Name="MeasuresCompareButton"
                        Style="{StaticResource FeatureCardButton}"
                        Content="Сравнение замеров"
                        Tag="default"
                        Click="MeasuresCompareButton_Click"/>
                <Button x:Name="RoomMaterialsButton"
                        Style="{StaticResource FeatureCardButton}"
                        Content="Материалы по комнатам"
                        Tag="default"
                        Click="RoomMaterialsButton_Click"/>
                <Button x:Name="TypeParametersButton"
                        Style="{StaticResource FeatureCardButton}"
                        Content="Изменение параметров типов"
                        Tag="default"
                        Click="TypeParametersButton_Click"/>
                <Button x:Name="DsTkChangeButton"
                        Style="{StaticResource FeatureCardButton}"
                        Content="ДС по изменению ТК"
                        Tag="muted"
                        Click="DsTkChangeButton_Click"/>
            </StackPanel>

            <Grid Grid.Row="4">
                <Border Background="#F0F9FF"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,120,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        x:Name="StatusBanner">
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="13"
                               Foreground="#1B6FC8"
                               TextWrapping="Wrap"/>
                </Border>
                <Border x:Name="StatusPlainHost"
                        Margin="0,0,120,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusPlainText"
                               FontSize="13"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"/>
                </Border>
                <Button x:Name="CloseButton"
                        Content="Закрыть"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
