<Window x:Class="SmartRemont.ExportRooms.Views.TypeParameterChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Изменение параметров типов"
        MinWidth="840"
        MinHeight="620"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ComboField" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Изменение параметров типов" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Выберите категорию, семейство и тип. Можно изменить только «ID материала» и «ID типа материала»."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ContentCard}" Padding="18,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Категория" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CategoryComboBox"
                                  Style="{StaticResource ComboField}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="CategoryComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Семейство" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FamilyComboBox"
                                  Style="{StaticResource ComboField}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="FamilyComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Тип" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TypeComboBox"
                                  Style="{StaticResource ComboField}"
                                  DisplayMemberPath="Name"
                                  Margin="0"
                                  SelectionChanged="TypeComboBox_SelectionChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="StatusBanner"
                    Grid.Row="1"
                    Style="{StaticResource InsetPanel}"
                    Padding="12,10"
                    Margin="0,0,0,14">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Выберите тип для просмотра параметров."
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </Border>

                <DataGrid x:Name="ParametersDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MinRowHeight="40"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр"
                                            Binding="{Binding Name}"
                                            IsReadOnly="True"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Текущее значение"
                                            Binding="{Binding CurrentValue}"
                                            IsReadOnly="True"
                                            Width="2*"/>
                        <DataGridTemplateColumn Header="Новое значение" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEdit}"
                                             Style="{StaticResource EditableCellTextBox}"
                                             HorizontalContentAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding StorageTypeName}"
                                            IsReadOnly="True"
                                            Width="130"/>
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding EditNote}"
                                            IsReadOnly="True"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

            <Border Grid.Row="3" Style="{StaticResource ContentCard}" Padding="18,14" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Дублировать как" Style="{StaticResource CardTitle}" FontSize="13"/>
                        <TextBlock Text="Создаст новый тип с названием и параметрами выше"
                                   Style="{StaticResource CaptionText}"
                                   Width="210"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBox x:Name="NewTypeNameTextBox"
                             Grid.Column="1"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             TextChanged="NewTypeNameTextBox_TextChanged"/>

                    <Button x:Name="DuplicateButton"
                            Grid.Column="2"
                            Content="Дублировать"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="126"
                            IsEnabled="False"
                            Click="DuplicateButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionHintText"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Закрыть"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                    <Button x:Name="SaveButton"
                            Content="Сохранить изменения"
                            Style="{StaticResource ModernPrimaryButton}"
                            IsEnabled="False"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
