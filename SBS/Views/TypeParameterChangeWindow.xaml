<Window x:Class="SmartRemont.ExportRooms.Views.TypeParameterChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Изменение параметров типов"
        Width="980"
        MinWidth="820"
        Height="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="28,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ComboField" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="126"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B6FC8"/>
            <Setter Property="BorderBrush" Value="#1B6FC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#155CA7"/>
                                <Setter Property="BorderBrush" Value="#155CA7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CBD5E1"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Изменение параметров типов"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Выберите категорию, семейство и тип. Можно изменить только «ID материала» и «ID типа материала»."
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="КАТЕГОРИЯ" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CategoryComboBox"
                              Style="{StaticResource ComboField}"
                              DisplayMemberPath="Name"
                              SelectionChanged="CategoryComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="СЕМЕЙСТВО" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="FamilyComboBox"
                              Style="{StaticResource ComboField}"
                              DisplayMemberPath="Name"
                              SelectionChanged="FamilyComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ТИП" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TypeComboBox"
                              Style="{StaticResource ComboField}"
                              DisplayMemberPath="Name"
                              Margin="0"
                              SelectionChanged="TypeComboBox_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <Border x:Name="StatusBanner"
                    Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,14">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Выберите тип для просмотра параметров."
                           FontSize="12"
                           Foreground="#475569"
                           TextWrapping="Wrap"/>
            </Border>

            <DataGrid x:Name="ParametersDataGrid"
                      Grid.Row="3"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      BorderBrush="#E5E7EB"
                      BorderThickness="1"
                      Background="White"
                      FontSize="13"
                      MinRowHeight="36"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Параметр"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="2*"/>
                    <DataGridTextColumn Header="Текущее значение"
                                        Binding="{Binding CurrentValue}"
                                        IsReadOnly="True"
                                        Width="2*"/>
                    <DataGridTemplateColumn Header="Новое значение" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Тип"
                                        Binding="{Binding StorageTypeName}"
                                        IsReadOnly="True"
                                        Width="130"/>
                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding EditNote}"
                                        IsReadOnly="True"
                                        Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="ДУБЛИРОВАТЬ КАК"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Создаст новый тип с названием и параметрами выше"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Width="200"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBox x:Name="NewTypeNameTextBox"
                             Grid.Column="1"
                             Height="36"
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"
                             Margin="0,0,12,0"
                             TextChanged="NewTypeNameTextBox_TextChanged"/>

                    <Button x:Name="DuplicateButton"
                            Grid.Column="2"
                            Content="Дублировать"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="DuplicateButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="0,14,0,0">
                <TextBlock x:Name="SelectionHintText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton"
                            Content="Сохранить изменения"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="SaveButton_Click"
                            Margin="0,0,10,0"/>
                    <Button Content="Закрыть"
                            Style="{StaticResource SecondaryButton}"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
