<Window x:Class="SmartRemont.ExportRooms.Views.RoomMeasurementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Замеры комнат"
        MinWidth="960"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RoomListItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="8,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <Border x:Name="Accent"
                                        Width="3"
                                        CornerRadius="2"
                                        Margin="0,8"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AppPrimaryBrush}"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xED5E;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Замеры комнат" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Сравниваем значения в системе с ведомостями Revit. При отправке в систему уйдут значения из колонки «Уйдёт в систему»."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Click="OpenSettingsButton_Click"
                        Style="{StaticResource ModernSecondaryButton}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTip="Указать, из каких спецификаций Revit брать каждый параметр">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Настроить источники" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="EventStatusBanner"
                    Grid.Row="0"
                    Style="{StaticResource CalloutInfo}"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource CalloutIcon}" Foreground="{StaticResource InfoBrush}"/>
                    <TextBlock x:Name="EventStatusBannerText"
                               Grid.Column="1"
                               FontSize="13"
                               Foreground="{StaticResource InfoTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Комнаты -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="Комнаты" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SummaryHintText"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="RoomsListBox"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0,6"
                                 ItemContainerStyle="{StaticResource RoomListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="RoomsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RoomName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource AppPrimaryBrush}"
                                                CornerRadius="999"
                                                MinWidth="22"
                                                Padding="7,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Параметров к отправке"
                                                Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding OutgoingCount}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextOnPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Параметры выбранной комнаты -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                            <StackPanel>
                                <TextBlock Text="{Binding ElementName=RoomsListBox, Path=SelectedItem.RoomName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="«В системе» — текущее значение, «Уйдёт в систему» — найдено в Revit и будет отправлено."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ElementName=RoomsListBox, Path=SelectedItem.Parameters}"
                                  Style="{StaticResource ModernDataGrid}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  MinHeight="160"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Параметр" Binding="{Binding param_name}" Width="2.2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextBase}">
                                            <Setter Property="Padding" Value="0,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Код" Binding="{Binding param_code}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="В системе" Binding="{Binding CurrentValueDisplay}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Изменение" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DiffDisplay}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,4,0"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WillSend}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Уйдёт в систему" Binding="{Binding param_value_display}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    x:Name="NoDataTextBlockHost"
                    Visibility="{Binding Visibility, ElementName=NoDataTextBlock}"
                    Style="{StaticResource ModernCard}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="&#xE9CE;" Style="{StaticResource IconGlyph}" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="NoDataTextBlock"
                               Text="Не удалось прочитать данные из спецификаций. Проверьте «Настроить источники»."
                               Style="{StaticResource EmptyStateText}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Превью отправки -->
            <Border x:Name="PreviewPanel"
                    Grid.Row="2"
                    Style="{StaticResource ModernCard}"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                        <StackPanel>
                            <TextBlock Text="Превью отправки" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="PreviewSummaryText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="12,6">
                        <ItemsControl x:Name="PreviewItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RoomName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding ParamName}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SourceHint}" Style="{StaticResource CaptionText}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SystemDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="3" Text="&#xE72A;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding RevitDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding ActionBrush}"
                                                    CornerRadius="999"
                                                    Padding="9,2">
                                                <TextBlock Text="{Binding ActionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ActionForeground}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviewToggleButton"
                            Content="Превью отправки"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Click="PreviewToggleButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                    <Button x:Name="SendButton"
                            Content="Отправить"
                            Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="140"
                            IsDefault="True"
                            IsEnabled="False"
                            Click="SendButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <local:LoadingOverlay x:Name="LoaderOverlay" Grid.RowSpan="3" Panel.ZIndex="1000"/>
    </Grid>
</Window>
