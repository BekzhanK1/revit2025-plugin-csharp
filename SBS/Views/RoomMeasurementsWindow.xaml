<Window x:Class="SmartRemont.ExportRooms.Views.RoomMeasurementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Замеры комнат"
        Width="960"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AnimatedRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                    <!-- Fade-in animation for rows -->
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Замеры комнат" Style="{StaticResource Heading1}"/>
                <TextBlock Text="По каждому помещению: param_name, param_code, param_value из спецификаций Revit." Style="{StaticResource BodyText}"/>
            </StackPanel>

            <Border x:Name="EventStatusBanner"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#1D4ED8"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="EventStatusBannerText"
                               FontSize="13"
                               Foreground="#1E40AF"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ПО КОМНАТАМ" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RoomName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <DataGrid ItemsSource="{Binding Parameters}"
                                                      Style="{StaticResource ModernDataGrid}"
                                                      RowStyle="{StaticResource AnimatedRowStyle}"
                                                      MinHeight="120"
                                                      IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="param_name" Binding="{Binding param_name}" Width="2*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="param_code" Binding="{Binding param_code}" Width="160">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="param_value" Binding="{Binding param_value_display}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               x:Name="NoDataTextBlock"
                               Text="Не удалось прочитать данные из спецификаций."
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="MappingPanel"
                    Grid.Row="3"
                    Background="#FAFAFA"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="МАППИНГ ПАРАМЕТРОВ → СПЕЦИФИКАЦИИ" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SourcesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="13" Margin="0,0,0,8" Text="{Binding LineText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,24,0,0">
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,400,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MappingToggleButton" Content="Маппинг параметров" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,12,0" Padding="20,0" Click="MappingToggleButton_Click"/>
                    <Button x:Name="CloseButton" Content="Закрыть" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,12,0" Padding="20,0" IsCancel="True" Click="CloseButton_Click"/>
                    <Button x:Name="SendButton" Content="Отправить" Style="{StaticResource ModernPrimaryButton}" IsDefault="True" IsEnabled="False" Padding="32,0" Click="SendButton_Click"/>
                </StackPanel>
            </Grid>
            <local:LoadingOverlay x:Name="LoaderOverlay" Grid.RowSpan="5" Panel.ZIndex="1000"/>
        </Grid>
    </Border>
</Window>
