<Window x:Class="SmartRemont.ExportRooms.Views.SelectedRemontSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — Площади (ДС)"
        Width="800"
        MinWidth="700"
        Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CompareRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                    <!-- Fade-in animation for rows -->
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F8FAFC"/>
                    </Trigger>
                    
                    <DataTrigger Binding="{Binding AreaCompareStatus}" Value="Match">
                        <Setter Property="Background" Value="#F0FDF4"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AreaCompareStatus}" Value="Mismatch">
                        <Setter Property="Background" Value="#FEF2F2"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AreaCompareStatus}" Value="SystemOnly">
                        <Setter Property="Background" Value="#FFFBEB"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AreaCompareStatus}" Value="RevitOnly">
                        <Setter Property="Background" Value="#EFF6FF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" 
                Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="24,20">
            <StackPanel>
                <TextBlock Text="Сверка площадей: Система и Revit"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,12,0">
                        <TextBlock x:Name="RemontIdHeroText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1D4ED8"/>
                    </Border>
                    <TextBlock x:Name="ClientRequestIdHeroText"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               x:Name="SystemDsInfoText"
                               FontSize="13"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" 
                               x:Name="PhaseHintText"
                               FontSize="13"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT (Table) -->
        <Border Grid.Row="1" Margin="24,20,24,0" 
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- Legend -->
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="12" CornerRadius="3" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBlock Text="Совпадает" FontSize="12" Foreground="#475569"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="12" CornerRadius="3" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBlock Text="Расхождение" FontSize="12" Foreground="#475569"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="12" CornerRadius="3" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBlock Text="Только система" FontSize="12" Foreground="#475569"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="12" CornerRadius="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,6,0"/>
                                <TextBlock Text="Только Revit" FontSize="12" Foreground="#475569"/>
                            </StackPanel>
                        </WrapPanel>
                        
                        <CheckBox x:Name="DifferencesOnlyCheckBox"
                                  Content="Показать только разницу"
                                  FontSize="13"
                                  Foreground="#334155"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Checked="DifferencesOnlyCheckBox_Changed"
                                  Unchecked="DifferencesOnlyCheckBox_Changed"/>
                    </Grid>
                </Border>

                <!-- DataGrid without borders to blend smoothly -->
                <DataGrid Grid.Row="1"
                          x:Name="RoomsDataGrid"
                          RowStyle="{StaticResource CompareRowStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="44"
                          Margin="0,0,0,8">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0E7FF"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="*"/>
                        <DataGridTextColumn Header="Система, м²" Binding="{Binding SystemAreaDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Revit, м²" Binding="{Binding AreaDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Δ" Binding="{Binding AreaDeltaDisplay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Выс. Revit, м" Binding="{Binding HeightDisplay}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPayloadHeight}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#2563EB"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="NoRoomsTextBlock"
                           Text="В модели нет размещённых помещений для выбранной фазы."
                           FontSize="14"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Grid.Row="1"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16" Margin="0,20,0,0">
            <Grid>
                <!-- Wall Height Payload & Status Info -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="13"
                               Foreground="#64748B"
                               FontWeight="Medium"
                               Margin="0,0,0,4"/>
                    
                    <StackPanel x:Name="PayloadWallHeightPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Отправка высоты:" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                        <TextBlock x:Name="PayloadWallHeightText" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/>
                        <TextBlock Text=" м" FontSize="12" Foreground="#2563EB"/>
                        <TextBlock x:Name="WallHeightCompareText" FontSize="12" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalAreaText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,24,0"
                               VerticalAlignment="Center"/>
                    
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource ModernSecondaryButton}"
                            Margin="0,0,12,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                    <Button x:Name="SendButton"
                            Content="Отправить"
                            Style="{StaticResource ModernPrimaryButton}"
                            IsDefault="True"
                            IsEnabled="False"
                            Click="SendButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <local:LoadingOverlay x:Name="LoaderOverlay" Grid.RowSpan="3" Panel.ZIndex="1000"/>
    </Grid>
</Window>
