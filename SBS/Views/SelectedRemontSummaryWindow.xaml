<Window x:Class="SmartRemont.ExportRooms.Views.SelectedRemontSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — Помещения"
        Width="760"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="32,28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBlock" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B6FC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#155BB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FBFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AreaCompareRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AreaCompareStatus}" Value="Match">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AreaCompareStatus}" Value="Mismatch">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AreaCompareStatus}" Value="SystemOnly">
                    <Setter Property="Background" Value="#FFF8E1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AreaCompareStatus}" Value="RevitOnly">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="EventStatusBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#1B6FC8"
                               VerticalAlignment="Top"
                               Margin="0,2,10,0"/>
                    <TextBlock x:Name="EventStatusBannerText"
                               FontSize="13"
                               Foreground="#1E40AF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="Помещения"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1B"
                       Margin="0,0,0,20"/>

            <Border Grid.Row="2" Style="{StaticResource SectionBlock}">
                <StackPanel>
                    <TextBlock Text="РЕМОНТ" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RemontNameText" Style="{StaticResource InfoValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ID ремонта" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RemontIdText" Style="{StaticResource InfoValue}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ID заявки" Style="{StaticResource InfoLabel}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ClientRequestIdText" Style="{StaticResource InfoValue}" Margin="0,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource SectionBlock}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ПЛОЩАДИ: СИСТЕМА И REVIT" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <TextBlock x:Name="PhaseHintText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#999999"/>
                            </Grid>
                            <TextBlock x:Name="SystemDsInfoText"
                                       FontSize="12"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CompareLegendPanel"
                            Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,6"
                            Visibility="Collapsed">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#E8F5E9" Margin="0,0,6,0"/>
                                <TextBlock Text="Совпадает" FontSize="11" Foreground="#555555"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#FFEBEE" Margin="0,0,6,0"/>
                                <TextBlock Text="Расхождение" FontSize="11" Foreground="#555555"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#FFF8E1" Margin="0,0,6,0"/>
                                <TextBlock Text="Только система" FontSize="11" Foreground="#555555"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#E3F2FD" Margin="0,0,6,0"/>
                                <TextBlock Text="Только Revit" FontSize="11" Foreground="#555555"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border x:Name="PayloadWallHeightPanel"
                            Grid.Row="2"
                            Background="#EFF6FF"
                            BorderBrush="#93C5FD"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Высота потолка"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#1D4ED8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <TextBlock Text="Система"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock x:Name="SystemWallHeightText"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#334155"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" м"
                                                   FontSize="12"
                                                   Foreground="#334155"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="|"
                                               FontSize="12"
                                               Foreground="#CBD5E1"
                                               VerticalAlignment="Center"
                                               Margin="0,0,20,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <TextBlock Text="Revit"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock x:Name="PayloadWallHeightText"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#1B6FC8"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" м"
                                                   FontSize="12"
                                                   Foreground="#1B6FC8"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WallHeightCompareText"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Grid>
                            <TextBlock x:Name="PayloadWallHeightNoteText"
                                       FontSize="10"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="DifferencesOnlyCheckBox"
                              Grid.Row="3"
                              Content="Только расхождения"
                              FontSize="13"
                              Margin="0,0,0,6"
                              Checked="DifferencesOnlyCheckBox_Changed"
                              Unchecked="DifferencesOnlyCheckBox_Changed"/>

                    <DataGrid Grid.Row="4"
                              x:Name="RoomsDataGrid"
                              RowStyle="{StaticResource AreaCompareRowStyle}"
                              MinHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Помещение"
                                                Binding="{Binding RoomName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Система, м²"
                                                Binding="{Binding SystemAreaDisplay}"
                                                Width="96"/>
                            <DataGridTextColumn Header="Revit, м²"
                                                Binding="{Binding AreaDisplay}"
                                                Width="88"/>
                            <DataGridTextColumn Header="Δ"
                                                Binding="{Binding AreaDeltaDisplay}"
                                                Width="72"/>
                            <DataGridTextColumn Header="Выс. Revit, м"
                                                Binding="{Binding HeightDisplay}"
                                                Width="96">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPayloadHeight}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#1B6FC8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="5"
                            Background="#EEF4FC"
                            CornerRadius="4"
                            Padding="14,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="Итого"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#555555"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalAreaText"
                                       HorizontalAlignment="Right"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#1B6FC8"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="6"
                               x:Name="NoRoomsTextBlock"
                               Text="В модели нет размещённых помещений для выбранной фазы."
                               FontSize="13"
                               Foreground="#999999"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,24,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#666666"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                    <Button x:Name="SendButton"
                            Content="Отправить"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            IsEnabled="False"
                            Click="SendButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
