<Window x:Class="SmartRemont.ExportRooms.Views.AuthLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Smart Remont"
        Width="440"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="24" Padding="40,32">
        <StackPanel>
            <!-- Logo -->
            <Image x:Name="CompanyLogoImage"
                   MaxHeight="44"
                   Margin="0,0,0,16"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   Visibility="Collapsed"/>

            <!-- Title -->
            <TextBlock Text="Smart Remont"
                       Style="{StaticResource Heading1}"/>
            <TextBlock Text="Войдите, чтобы продолжить"
                       Style="{StaticResource BodyText}"
                       Margin="0,0,0,32"/>

            <!-- Email -->
            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="EmailTextBox"
                     Style="{StaticResource ModernInputField}"
                     Margin="0,0,0,20"/>

            <!-- Password -->
            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource ModernPasswordField}"
                         Margin="0,0,0,20"
                         KeyDown="PasswordBox_KeyDown"/>

            <!-- Error -->
            <Border x:Name="ErrorBorder"
                    Background="{StaticResource ErrorBackgroundBrush}"
                    BorderBrush="{StaticResource ErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12"
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconWarning}" 
                          Fill="{StaticResource ErrorBrush}" 
                          Width="16" Height="16" 
                          Stretch="Uniform"
                          VerticalAlignment="Top"
                          Margin="0,2,8,0"/>
                    <TextBlock x:Name="ErrorTextBlock"
                               FontSize="13"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Отмена"
                        Style="{StaticResource ModernSecondaryButton}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>

                <Button x:Name="LoginButton"
                        Grid.Column="2"
                        Content="Войти"
                        Style="{StaticResource ModernPrimaryButton}"
                        IsDefault="True"
                        Click="LoginButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
