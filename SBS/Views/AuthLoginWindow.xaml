<Window x:Class="SmartRemont.ExportRooms.Views.AuthLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Smart Remont"
        Width="400"
        MinWidth="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               x:Name="CompanyLogoImage"
               MaxHeight="48"
               Margin="0,0,0,12"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               Visibility="Collapsed"/>
        <TextBlock Grid.Row="1"
                   Text="Войдите, чтобы продолжить"
                   Foreground="Gray"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="2" Text="Email" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="EmailTextBox" Height="28" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Text="Пароль" Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="5"
                     x:Name="PasswordBox"
                     Height="28"
                     Margin="0,0,0,12"
                     KeyDown="PasswordBox_KeyDown"/>

        <TextBlock Grid.Row="6"
                   x:Name="ErrorTextBlock"
                   Foreground="Firebrick"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="LoginButton"
                    Content="Войти"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
