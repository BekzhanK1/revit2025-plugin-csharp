<Window x:Class="SmartRemont.ExportRooms.Views.DsTkChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — ДС на изменение ТК"
        MinWidth="900"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WrapCellText" TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextBase}"/>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatDot" TargetType="Border">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="ДС на изменение ТК" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Сверка состава с договором: чего нет в проекте и что лишнее. Из Revit в ДС уходят только объёмы; удалить, добавить или заменить материал можно только в MySpace."
                               Style="{StaticResource PageSubtitle}"/>

                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Style="{StaticResource ChipInfo}" Margin="0,0,8,0">
                            <TextBlock x:Name="ClientRequestBadge"
                                       Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       Text="Заявка #—"/>
                        </Border>
                        <Border x:Name="DsBadgeBorder" Style="{StaticResource Chip}" Margin="0,0,12,0">
                            <TextBlock x:Name="DsBadgeText" Style="{StaticResource ChipText}" Text="ДС: —"/>
                        </Border>
                        <Button x:Name="CreateDsButton"
                                Style="{StaticResource CompactSecondaryButton}"
                                Margin="0,0,6,0"
                                Click="CreateDsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Создать ДС" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PickDsButton"
                                Content="Выбрать…"
                                Style="{StaticResource CompactSecondaryButton}"
                                Margin="0,0,12,0"
                                Click="PickDsButton_Click"/>
                        <TextBlock x:Name="ScanInfoText"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Text=""/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}"
                            Margin="0,0,4,0"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportJsonButton"
                            Style="{StaticResource GhostButton}"
                            Click="ExportJsonButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Экспорт JSON" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="28,20,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Сводка -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatRoomsValue" Style="{StaticResource StatValue}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock Text="комнат" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatMatchValue" Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessTextBrush}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="совпадает" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatMissingRevitValue" Style="{StaticResource StatValue}" Foreground="{StaticResource WarningTextBrush}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource WarningBrush}"/>
                            <TextBlock Text="нет в проекте" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatExtraValue" Style="{StaticResource StatValue}" Foreground="#C2410C" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="#F97316"/>
                            <TextBlock Text="лишнее" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatBadge}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="StatQtyMismatchValue" Style="{StaticResource StatValue}" Foreground="{StaticResource InfoTextBrush}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource InfoBrush}"/>
                            <TextBlock x:Name="StatQtyMismatchLabel" Text="к отправке" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Предупреждение по составу + статус -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Border x:Name="MismatchWarningPanel"
                        Style="{StaticResource CalloutWarning}"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource CalloutIcon}" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock x:Name="MismatchWarningText"
                                   Grid.Column="1"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningTextBrush}"
                                   Text=""/>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Загрузка…"/>
            </StackPanel>

            <!-- Помещения -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="ПОМЕЩЕНИЯ" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ProblemsOnlyCheckBox"
                              Content="Только «нет» и «лишнее»"
                              IsChecked="True"
                              HorizontalAlignment="Right"
                              Checked="ProblemsOnlyCheckBox_Changed"
                              Unchecked="ProblemsOnlyCheckBox_Changed"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,10"
                                              Padding="16,0,16,16"
                                              IsExpanded="True">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RoomName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding SummaryBadge}" Style="{StaticResource ChipText}" FontWeight="Normal"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <DataGrid ItemsSource="{Binding Rows}"
                                                  Style="{StaticResource ModernDataGrid}"
                                                  views:ScrollBehavior.BubbleMouseWheel="True"
                                                  MinHeight="40"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  AutoGenerateColumns="False">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="missing_revit">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="not_expected">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="extra">
                                                            <Setter Property="Background" Value="#FFF4EC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_mismatch">
                                                            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_project_alert">
                                                            <Setter Property="Background" Value="#FFF4EC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_blocked">
                                                            <Setter Property="Background" Value="#F5F3FF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="2.4*" MinWidth="160">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="SR_ID" Binding="{Binding MaterialIdDisplay}" Width="80" MinWidth="64">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Конструктив" Binding="{Binding WorkSetName}" Width="1.4*" MinWidth="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Тип" Binding="{Binding KindDisplay}" Width="90" MinWidth="70">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="ДС/ТК" Binding="{Binding TkQtyDisplay}" Width="70" MinWidth="56"/>
                                                <DataGridTextColumn Header="Проект" Binding="{Binding ScheduleQtyDisplay}" Width="70" MinWidth="56"/>
                                                <DataGridTextColumn Header="Объём" Binding="{Binding QtyStatusDisplay}" Width="150" MinWidth="110">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_mismatch">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_project_alert">
                                                                    <Setter Property="Foreground" Value="#C2410C"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_blocked">
                                                                    <Setter Property="Foreground" Value="#6D28D9"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_match">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="В Revit" Binding="{Binding RevitName}" Width="1.2*" MinWidth="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60" MinWidth="48"/>
                                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="120" MinWidth="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoDataText"
                                   Text="Нет данных для сверки."
                                   Style="{StaticResource EmptyStateText}"
                                   Margin="0,32"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- FOOTER: отправка объёмов -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Отправка объёмов"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="QtyCandidateBadge"
                                Style="{StaticResource ChipInfo}"
                                Margin="10,0,0,0">
                            <TextBlock x:Name="QtyCandidateBadgeText"
                                       Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       Text="0 позиций"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="QtyModeHintText"
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0"
                               Text="В ДС уходят только объёмы, которые в MySpace можно править вручную. Пока состав проекта не совпадает с договором, отправка выключена."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Закрыть"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                    <Button x:Name="ApplyQtyButton"
                            Content="Проверить и отправить"
                            Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="190"
                            Padding="18,0"
                            Click="ApplyQtyButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
