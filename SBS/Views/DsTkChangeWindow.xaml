<Window x:Class="SmartRemont.ExportRooms.Views.DsTkChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartRemont.ExportRooms.Views"
        Title="Smart Remont — ДС на изменение ТК"
        MinWidth="900"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WrapCellText" TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextBase}"/>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatDot" TargetType="Border">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource HeaderIconGlyph}"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="ДС на изменение ТК" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Из модели в черновик ДС уходят объёмы и замеры комнат. Добавить, удалить или заменить материал — только в MySpace."
                               Style="{StaticResource PageSubtitle}"/>

                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Style="{StaticResource ChipInfo}" Margin="0,0,8,0">
                            <TextBlock x:Name="ClientRequestBadge"
                                       Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       Text="Заявка #—"/>
                        </Border>
                        <Border x:Name="DsBadgeBorder" Style="{StaticResource Chip}" Margin="0,0,12,0">
                            <TextBlock x:Name="DsBadgeText" Style="{StaticResource ChipText}" Text="ДС: —"/>
                        </Border>
                        <Button x:Name="CreateDsButton"
                                Style="{StaticResource CompactSecondaryButton}"
                                Margin="0,0,6,0"
                                Click="CreateDsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Создать ДС" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PickDsButton"
                                Content="Выбрать…"
                                Style="{StaticResource CompactSecondaryButton}"
                                Margin="0,0,12,0"
                                Click="PickDsButton_Click"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}"
                            Margin="0,0,4,0"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton"
                            Style="{StaticResource GhostButton}"
                            ToolTip="Диагностика и JSON"
                            Click="MoreButton_Click">
                        <TextBlock Text="&#xE712;" Style="{StaticResource IconGlyph}" FontSize="13"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ScanInfoMenuItem" Header="Сканирование модели: —" IsEnabled="False"/>
                                <Separator/>
                                <MenuItem Header="Скопировать JSON отправки"
                                          ToolTip="Тело запроса в ДС (замеры + объёмы), расчёт по каждой строке ДС и строки ведомостей. Ничего не отправляет."
                                          Click="CopySendJsonButton_Click"/>
                                <MenuItem Header="Сохранить JSON сверки…"
                                          Click="ExportJsonButton_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="28,20,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Сводка -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatRoomsValue" Style="{StaticResource StatValue}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock Text="комнат" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatMatchValue" Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessTextBrush}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="совпадает" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatMissingRevitValue" Style="{StaticResource StatValue}" Foreground="{StaticResource WarningTextBrush}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource WarningBrush}"/>
                            <TextBlock Text="нет в модели" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatExtraValue" Style="{StaticResource StatValue}" Foreground="{StaticResource ExtraTextBrush}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource ExtraBrush}"/>
                            <TextBlock Text="лишнее в модели" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatBadge}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="StatQtyMismatchValue" Style="{StaticResource StatValue}" Foreground="{StaticResource InfoTextBrush}" Text="—"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Style="{StaticResource StatDot}" Background="{StaticResource InfoBrush}"/>
                            <TextBlock x:Name="StatQtyMismatchLabel" Text="строк к отправке" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Margin="0,0,0,12"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Загрузка…"/>

            <!-- Вкладки -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Border Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FixTab"
                                     GroupName="DsTkTabs"
                                     Style="{StaticResource SegmentTab}"
                                     IsChecked="True"
                                     ToolTip="Что мешает отправке и что правится в MySpace"
                                     Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Исправить" VerticalAlignment="Center"/>
                                <Border x:Name="FixTabCountBorder" Style="{StaticResource SegmentCount}">
                                    <TextBlock x:Name="FixTabCountText" Text="—" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SendTab"
                                     GroupName="DsTkTabs"
                                     Style="{StaticResource SegmentTab}"
                                     ToolTip="Какие объёмы уйдут в ДС: было → станет"
                                     Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Уйдёт в ДС" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource SegmentCount}" Background="{StaticResource InfoSoftBrush}">
                                    <TextBlock x:Name="SendTabCountText" Text="—" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource InfoTextBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TableTab"
                                     GroupName="DsTkTabs"
                                     Style="{StaticResource SegmentTab}"
                                     Margin="0"
                                     ToolTip="Полная сверка состава и объёмов по комнатам"
                                     Checked="Tab_Checked">
                            <TextBlock Text="Таблица сверки" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="ProblemsOnlyCheckBox"
                          Content="Только проблемы"
                          ToolTip="Нет в модели, лишнее в модели и объёмы, которые не уйдут в ДС"
                          IsChecked="True"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Checked="ProblemsOnlyCheckBox_Changed"
                          Unchecked="ProblemsOnlyCheckBox_Changed"/>
            </Grid>

            <Grid Grid.Row="3">
                <!-- Вкладка «Исправить» -->
                <ScrollViewer x:Name="FixPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="WarningGroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="18,14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                                                                <Setter Property="Text" Value="&#xEA39;"/>
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Hint}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource DividerBrush}"
                                                                    BorderThickness="0,1,0,0"
                                                                    Padding="0,9,0,0"
                                                                    Margin="0,9,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Text}"
                                                                               FontSize="13"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,3,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding}"
                                                                                           FontSize="12"
                                                                                           Margin="0,1,0,0"
                                                                                           TextWrapping="Wrap"
                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="FixEmptyPanel"
                                    HorizontalAlignment="Center"
                                    Margin="0,40"
                                    Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;"
                                       Style="{StaticResource IconGlyph}"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Исправлять нечего"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Модель считается без ошибок. Что уйдёт — на вкладке «Уйдёт в ДС»."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Вкладка «Уйдёт в ДС» -->
                <Grid x:Name="SendPanel" Visibility="Collapsed">
                    <DataGrid x:Name="SendGrid"
                              Style="{StaticResource ModernDataGrid}"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Комната" Binding="{Binding RoomName}" Width="1*" MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Конструктив" Binding="{Binding WorkSetName}" Width="1.2*" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="2.6*" MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Было (ДС)" Binding="{Binding FromDisplay}" Width="90" MinWidth="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Станет" Binding="{Binding ToDisplay}" Width="90" MinWidth="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60" MinWidth="44">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="1.4*" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SendEmptyText"
                               Style="{StaticResource EmptyStateText}"
                               Margin="0,40"
                               Visibility="Collapsed"
                               Text="Отправлять нечего."/>
                </Grid>

                <!-- Вкладка «Таблица сверки» -->
                <ScrollViewer x:Name="TablePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="RoomsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,10"
                                              Padding="16,0,16,16"
                                              IsExpanded="True">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RoomName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding SummaryBadge}" Style="{StaticResource ChipText}" FontWeight="Normal"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <DataGrid ItemsSource="{Binding Rows}"
                                                  Style="{StaticResource ModernDataGrid}"
                                                  views:ScrollBehavior.BubbleMouseWheel="True"
                                                  MinHeight="40"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  AutoGenerateColumns="False">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="missing_revit">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="not_expected">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="extra">
                                                            <Setter Property="Background" Value="{StaticResource ExtraSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_mismatch">
                                                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_project_alert">
                                                            <Setter Property="Background" Value="{StaticResource ExtraSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_blocked">
                                                            <Setter Property="Background" Value="{StaticResource BlockedSoftBrush}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="2.4*" MinWidth="160">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="SR_ID" Binding="{Binding MaterialIdDisplay}" Width="80" MinWidth="64">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Конструктив" Binding="{Binding WorkSetName}" Width="1.4*" MinWidth="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Тип" Binding="{Binding KindDisplay}" Width="90" MinWidth="70">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="ДС/ТК" Binding="{Binding TkQtyDisplay}" Width="70" MinWidth="56"/>
                                                <DataGridTextColumn Header="Модель" Binding="{Binding ScheduleQtyDisplay}" Width="70" MinWidth="56"/>
                                                <DataGridTextColumn Header="Объём" Binding="{Binding QtyStatusDisplay}" Width="150" MinWidth="110">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_mismatch">
                                                                    <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_project_alert">
                                                                    <Setter Property="Foreground" Value="{StaticResource ExtraTextBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_blocked">
                                                                    <Setter Property="Foreground" Value="{StaticResource BlockedTextBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_match">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="В Revit" Binding="{Binding RevitName}" Width="1.2*" MinWidth="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Элементов" Binding="{Binding Quantity}" Width="76" MinWidth="60"/>
                                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="120" MinWidth="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoDataText"
                                   Text="Нет данных для сверки."
                                   Style="{StaticResource EmptyStateText}"
                                   Margin="0,32"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- FOOTER: отправка объёмов -->
        <Border Grid.Row="2" Style="{StaticResource PageFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Отправка объёмов"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="QtyCandidateBadge"
                                Style="{StaticResource ChipInfo}"
                                Margin="10,0,0,0">
                            <TextBlock x:Name="QtyCandidateBadgeText"
                                       Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       Text="0 строк"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="QtyModeHintText"
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Замеры комнат и объёмы строк с ручным вводом. Работы и сумму MySpace посчитает сам."/>
                    <TextBlock x:Name="SendBlockText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource ErrorTextBrush}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Закрыть"
                            Style="{StaticResource ModernSecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                    <!-- Только для теста: отправляет готовые позиции, когда остальные заблокированы. -->
                    <Button x:Name="ForceSendButton"
                            Content="Отправить всё равно (тест)"
                            Style="{StaticResource DangerGhostButton}"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            ToolTip="Только для теста: в ДС уйдут готовые позиции, проблемные пропускаются"
                            Click="ForceSendButton_Click"/>
                    <Button x:Name="ApplyQtyButton"
                            Content="Проверить и отправить"
                            Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="190"
                            Padding="18,0"
                            Click="ApplyQtyButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
