<Window x:Class="SmartRemont.ExportRooms.Views.DsTkChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Remont — ДС на изменение ТК"
        Width="1100"
        MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmartRemont.ExportRooms;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WrapCellText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModernCard}" Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header with Title and Global Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="ДС на изменение ТК" Style="{StaticResource Heading1}"/>
                    <TextBlock Text="Сверка состава с договором: чего нет в проекте и что лишнее. Объёмы в ДС — только как в MySpace."
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock x:Name="ClientRequestBadge" FontSize="13" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Заявка #—"/>
                        </Border>
                        <Border x:Name="DsBadgeBorder" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                            <TextBlock x:Name="DsBadgeText" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Text="ДС: —"/>
                        </Border>
                        <Button x:Name="CreateDsButton"
                                Content="Создать ДС"
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Click="CreateDsButton_Click"/>
                        <Button x:Name="PickDsButton"
                                Content="Выбрать…"
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                Padding="12,0"
                                Margin="0,0,12,0"
                                Click="PickDsButton_Click"/>
                        <TextBlock x:Name="ScanInfoText"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Text=""/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Обновить"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click"/>
                    <Button x:Name="ExportJsonButton"
                            Content="Экспорт JSON"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Padding="16,0"
                            Click="ExportJsonButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. Stats Panel -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatBadge}">
                    <StackPanel>
                        <TextBlock x:Name="StatRoomsValue" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="—"/>
                        <TextBlock Text="комнат" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatBadge}" Background="#F0FDF4" BorderBrush="#BBF7D0">
                    <StackPanel>
                        <TextBlock x:Name="StatMatchValue" FontSize="20" FontWeight="Bold" Foreground="#15803D" Text="—"/>
                        <TextBlock Text="совпадает" FontSize="12" Foreground="#166534"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatBadge}" Background="#FFFBEB" BorderBrush="#FDE68A">
                    <StackPanel>
                        <TextBlock x:Name="StatMissingRevitValue" FontSize="20" FontWeight="Bold" Foreground="#B45309" Text="—"/>
                        <TextBlock Text="нет в проекте" FontSize="12" Foreground="#92400E"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatBadge}" Background="#FFF7ED" BorderBrush="#FED7AA">
                    <StackPanel>
                        <TextBlock x:Name="StatExtraValue" FontSize="20" FontWeight="Bold" Foreground="#C2410C" Text="—"/>
                        <TextBlock Text="лишнее" FontSize="12" Foreground="#9A3412"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatBadge}" Background="#EFF6FF" BorderBrush="#BFDBFE" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="StatQtyMismatchValue" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8" Text="—"/>
                        <TextBlock x:Name="StatQtyMismatchLabel" Text="к отправке" FontSize="12" Foreground="#1E40AF"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Предупреждение по составу + короткий статус -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Border x:Name="MismatchWarningPanel"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MismatchWarningText"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="#9A3412"
                               Text=""/>
                </Border>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Загрузка…"/>
            </StackPanel>

            <!-- 4. Rooms List (Expander) -->
            <Border Grid.Row="3"
                    Background="#FAFAFA"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="ПОМЕЩЕНИЯ" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ProblemsOnlyCheckBox"
                                  Content="Только нет / лишнее"
                                  IsChecked="True"
                                  HorizontalAlignment="Right"
                                  Checked="ProblemsOnlyCheckBox_Changed"
                                  Unchecked="ProblemsOnlyCheckBox_Changed"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="RoomsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,12" 
                                                  Background="{StaticResource CardBackgroundBrush}"
                                                  BorderBrush="{StaticResource CardBorderBrush}"
                                                  BorderThickness="1"
                                                  IsExpanded="True">
                                            <!-- Style for rounded corners on Expander might need explicit Border in template, but WPF default is fine for now, or just use Padding -->
                                            <Expander.Header>
                                                <!-- Stretching Expander Header -->
                                                <Grid HorizontalAlignment="Stretch" Margin="0,8,0,8" Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}, Path=ActualWidth}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding RoomName}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding SummaryBadge}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,32,0"/>
                                                </Grid>
                                            </Expander.Header>
                                            <Expander.Content>
                                                <Border Padding="16,0,16,16">
                                                    <DataGrid ItemsSource="{Binding Rows}"
                                                              Style="{StaticResource ModernDataGrid}"
                                                              MinHeight="40"
                                                              IsReadOnly="True"
                                                              SelectionMode="Single"
                                                              SelectionUnit="FullRow"
                                                              AutoGenerateColumns="False"
                                                              BorderThickness="1"
                                                              BorderBrush="{StaticResource CardBorderBrush}">
                                                        <DataGrid.RowStyle>
                                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="match">
                                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="missing_revit">
                                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="not_expected">
                                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKey}" Value="extra">
                                                                        <Setter Property="Background" Value="#FFF7ED"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_mismatch">
                                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_project_alert">
                                                                        <Setter Property="Background" Value="#FFF7ED"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGrid.RowStyle>
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="2.4*" MinWidth="160">
                                                                <DataGridTextColumn.ElementStyle>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                                </DataGridTextColumn.ElementStyle>
                                                            </DataGridTextColumn>
                                                            <DataGridTextColumn Header="SR_ID" Binding="{Binding MaterialIdDisplay}" Width="80" MinWidth="64"/>
                                                            <DataGridTextColumn Header="Конструктив" Binding="{Binding WorkSetName}" Width="1.4*" MinWidth="100">
                                                                <DataGridTextColumn.ElementStyle>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                                </DataGridTextColumn.ElementStyle>
                                                            </DataGridTextColumn>
                                                            <DataGridTextColumn Header="Тип" Binding="{Binding KindDisplay}" Width="90" MinWidth="70"/>
                                                            <DataGridTextColumn Header="ДС/ТК"
                                                                                Binding="{Binding TkQtyDisplay}"
                                                                                Width="70"
                                                                                MinWidth="56"/>
                                                            <DataGridTextColumn Header="Проект" Binding="{Binding ScheduleQtyDisplay}" Width="70" MinWidth="56"/>
                                                            <DataGridTextColumn Header="Объём" Binding="{Binding QtyStatusDisplay}" Width="150" MinWidth="110">
                                                                <DataGridTextColumn.ElementStyle>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_mismatch">
                                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_project_alert">
                                                                                <Setter Property="Foreground" Value="#C2410C"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding QtyStatusKey}" Value="qty_match">
                                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </DataGridTextColumn.ElementStyle>
                                                            </DataGridTextColumn>
                                                            <DataGridTextColumn Header="В Revit" Binding="{Binding RevitName}" Width="1.2*" MinWidth="90">
                                                                <DataGridTextColumn.ElementStyle>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                                </DataGridTextColumn.ElementStyle>
                                                            </DataGridTextColumn>
                                                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="56" MinWidth="48"/>
                                                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="110" MinWidth="90"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Border>
                                            </Expander.Content>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoDataText"
                                       Text="Нет данных для сверки."
                                       Style="{StaticResource BodyText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,24"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 5. Bottom Action Bar -->
            <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Отправка объёмов"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="QtyCandidateBadge"
                                    Background="#DBEAFE"
                                    BorderBrush="#93C5FD"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="QtyCandidateBadgeText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#1D4ED8"
                                           Text="0 позиций"/>
                            </Border>
                        </StackPanel>
                        <!-- Close button is moved here on the right, keeping action bar clean -->
                        <Button Content="Закрыть"
                                Style="{StaticResource SecondaryButton}"
                                Height="32"
                                Padding="14,0"
                                IsCancel="True"
                                Click="CloseButton_Click"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="QtyModeHintText"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="В ДС уходят только объёмы, которые можно править в MySpace. Состав проекта пока не блокирует отправку."/>
                        </StackPanel>

                        <Button x:Name="ApplyQtyButton"
                                Grid.Column="1"
                                Content="Проверить и отправить"
                                Style="{StaticResource PrimaryButton}"
                                Height="40"
                                MinWidth="180"
                                Padding="18,0"
                                VerticalAlignment="Center"
                                Click="ApplyQtyButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
